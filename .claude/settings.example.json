{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "theme": "auto",
  "tui": "fullscreen",
  "alwaysThinkingEnabled": true,
  "effortLevel": "high",
  "autoCompactWindow": 200000,
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "defaultMode": "auto"
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/scripts/statusline.sh"
  },
  "hooks": {
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/bin/claude-notify",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ]
  }
}
