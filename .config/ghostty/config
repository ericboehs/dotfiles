# Theme
theme = light:Catppuccin Latte,dark:Catppuccin Mocha

# Font
font-family = SauceCodeProNerdFontMono
font-style = Regular
font-style-italic = Italic
font-style-bold-italic = Bold Italic
font-size = 20

# Window padding (border around terminal content)
window-padding-x = 10
window-padding-y = 10

# Image support
image-storage-limit = 320000000

# SSH: install ghostty terminfo on the remote on first connect, and fall back
# to xterm-256color if installation fails. Fixes "unsuitable terminal:
# xterm-ghostty" on hosts that don't have ghostty's terminfo entry.
shell-integration-features = ssh-env,ssh-terminfo

# Ensure Escape passes through to applications
keybind = escape=unbind

# Undo
keybind = super+z=text:\x1f

# Ctrl+1-9 keybindings to send escape sequences
keybind = ctrl+1=text:\x1b[27;5;49~
keybind = ctrl+2=text:\x1b[27;5;50~
keybind = ctrl+3=text:\x1b[27;5;51~
keybind = ctrl+4=text:\x1b[27;5;52~
keybind = ctrl+5=text:\x1b[27;5;53~
keybind = ctrl+6=text:\x1b[27;5;54~
keybind = ctrl+7=text:\x1b[27;5;55~
keybind = ctrl+8=text:\x1b[27;5;56~
keybind = ctrl+9=text:\x1b[27;5;57~

# Send Option as Alt rather than composing accented characters, so every Alt key
# reaches tmux and zsh. Replaces the per-key `keybind = alt+X=text:\x1bX` list
# this used to carry (M-h/l windows, M-j/k sessions, M-Tab, M-`, and friends).
# Trade-off: no more Opt-e -> é. Set to `left` to keep right-Option composing.
macos-option-as-alt = true

macos-titlebar-style = tabs
