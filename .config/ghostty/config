# Theme
theme = light:Catppuccin Latte,dark:Catppuccin Mocha

# Font
font-family = JetBrainsMono Nerd Font
font-style = Regular
font-style-italic = Italic
font-style-bold-italic = Bold Italic
font-size = 20

# Window padding (border around terminal content)
window-padding-x = 10
window-padding-y = 10

# Image support
image-storage-limit = 320000000

# SSH: install ghostty terminfo on the remote on first connect, and fall back
# to xterm-256color if installation fails. Fixes "unsuitable terminal:
# xterm-ghostty" on hosts that don't have ghostty's terminfo entry.
shell-integration-features = ssh-env,ssh-terminfo

# Ensure Escape passes through to applications
keybind = escape=unbind

# Undo
# Encode Cmd-Z as CSI-u Ctrl-minus. tmux forwards it to enhanced-key apps
# such as pi, and degrades it to the legacy Ctrl-_ byte for normal shells.
keybind = super+z=text:\x1b[45;5u

# Ctrl+1-9 switches tmux windows. Ghostty does not send anything distinguishable
# for a bare ctrl+digit, so these have to be written out as modifyOtherKeys
# sequences: `\x1b[27;<modifier>;<keycode>~`, modifier 5 being ctrl.
#
# Ctrl+Shift+hjkl (move window/session) and Ctrl+Shift+1-9 (switch session)
# are spelled out the same way, modifier 6 being ctrl+shift. Ghostty does emit
# those on its own, but only in a form tmux decodes while it has not asked for
# extended keys. tmux 3.8 recognizes Ghostty from its XTVERSION reply and turns
# on the extkeys feature by itself, after which Ghostty answers in
# modifyOtherKeys form with the *shifted* keycode (H is 72, ! instead of 1) and
# tmux reads C-H rather than C-S-h, so the bindings went dead after a Ghostty
# restart. Writing them out pins the *unshifted* keycode (h is 104, not 72)
# whatever mode tmux asks for.
keybind = ctrl+1=text:\x1b[27;5;49~
keybind = ctrl+2=text:\x1b[27;5;50~
keybind = ctrl+3=text:\x1b[27;5;51~
keybind = ctrl+4=text:\x1b[27;5;52~
keybind = ctrl+5=text:\x1b[27;5;53~
keybind = ctrl+6=text:\x1b[27;5;54~
keybind = ctrl+7=text:\x1b[27;5;55~
keybind = ctrl+8=text:\x1b[27;5;56~
keybind = ctrl+9=text:\x1b[27;5;57~

keybind = ctrl+shift+h=text:\x1b[27;6;104~
keybind = ctrl+shift+j=text:\x1b[27;6;106~
keybind = ctrl+shift+k=text:\x1b[27;6;107~
keybind = ctrl+shift+l=text:\x1b[27;6;108~
keybind = ctrl+shift+1=text:\x1b[27;6;49~
keybind = ctrl+shift+2=text:\x1b[27;6;50~
keybind = ctrl+shift+3=text:\x1b[27;6;51~
keybind = ctrl+shift+4=text:\x1b[27;6;52~
keybind = ctrl+shift+5=text:\x1b[27;6;53~
keybind = ctrl+shift+6=text:\x1b[27;6;54~
keybind = ctrl+shift+7=text:\x1b[27;6;55~
keybind = ctrl+shift+8=text:\x1b[27;6;56~
keybind = ctrl+shift+9=text:\x1b[27;6;57~

# Leave terminal-features alone rather than adding or stripping
# 'xterm-ghostty:extkeys' by hand: the explicit lines above work in either mode,
# and forcing the mode on leaks extended keys into applications that mishandle
# them.


# Send Option as Alt rather than composing accented characters, so every Alt key
# reaches tmux and zsh. Replaces the per-key `keybind = alt+X=text:\x1bX` list
# this used to carry (M-h/l windows, M-j/k sessions, M-Tab, M-`, and friends).
# Most of those moved to Ctrl/Ctrl-Shift above; Opt now only carries Tab/backtick
# cycling and Opt-l for clear-screen.
# Trade-off: no more Opt-e -> é. Set to `left` to keep right-Option composing.
macos-option-as-alt = true

macos-titlebar-style = tabs
