# Theme
theme = light:Catppuccin Latte,dark:Catppuccin Mocha

# Font
font-family = SauceCodeProNerdFontMono
font-style = Regular
font-style-italic = Italic
font-style-bold-italic = Bold Italic
font-size = 20

# Window padding (border around terminal content)
window-padding-x = 10
window-padding-y = 10

# Image support
image-storage-limit = 320000000

# SSH: install ghostty terminfo on the remote on first connect, and fall back
# to xterm-256color if installation fails. Fixes "unsuitable terminal:
# xterm-ghostty" on hosts that don't have ghostty's terminfo entry.
shell-integration-features = ssh-env,ssh-terminfo

# Ensure Escape passes through to applications
keybind = escape=unbind

# Undo
keybind = super+z=text:\x1f

# Ctrl+1-9 (windows), Ctrl+Shift+hjkl (move window/session) and Ctrl+Shift+1-9
# (switch session) used to be spelled out here as explicit escape sequences,
# 22 of them, in the modifyOtherKeys form `\x1b[27;<modifier>;<keycode>~`.
#
# They are gone because Ghostty already sends those sequences by itself. tmux
# only knows how to ask for extended keys through xterm's modifyOtherKeys and it
# never sends that request under TERM=xterm-ghostty, so the assumption was that
# nothing arrived unless it was written out here — but a tmux binding on
# Ctrl+Shift+G, a key with no entry in this file and no legacy encoding of its
# own, fired anyway, on a client with no `extkeys` feature negotiated.
#
# If a key ever stops registering, put its line back rather than reaching for
# `set -as terminal-features 'xterm-ghostty:extkeys'`: that makes tmux request
# the mode explicitly, but it also leaks extended keys into applications that
# mishandle them. Two details for writing one by hand: the payload carries the
# *unshifted* keycode (h is 104, not 72), and modifier 5 is ctrl while 6 is
# ctrl+shift.


# Send Option as Alt rather than composing accented characters, so every Alt key
# reaches tmux and zsh. Replaces the per-key `keybind = alt+X=text:\x1bX` list
# this used to carry (M-h/l windows, M-j/k sessions, M-Tab, M-`, and friends).
# Most of those moved to Ctrl/Ctrl-Shift above; Opt now only carries Tab/backtick
# cycling and Opt-l for clear-screen.
# Trade-off: no more Opt-e -> é. Set to `left` to keep right-Option composing.
macos-option-as-alt = true

macos-titlebar-style = tabs
