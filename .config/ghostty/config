# Theme
theme = light:Catppuccin Latte,dark:Catppuccin Mocha

# Font
font-family = SauceCodeProNerdFontMono
font-style = Regular
font-style-italic = Italic
font-style-bold-italic = Bold Italic
font-size = 20

# Window padding (border around terminal content)
window-padding-x = 10
window-padding-y = 10

# Image support
image-storage-limit = 320000000

# SSH: install ghostty terminfo on the remote on first connect, and fall back
# to xterm-256color if installation fails. Fixes "unsuitable terminal:
# xterm-ghostty" on hosts that don't have ghostty's terminfo entry.
shell-integration-features = ssh-env,ssh-terminfo

# Ensure Escape passes through to applications
keybind = escape=unbind

# Undo
keybind = super+z=text:\x1f

# Ctrl+1-9 keybindings to send escape sequences
keybind = ctrl+1=text:\x1b[27;5;49~
keybind = ctrl+2=text:\x1b[27;5;50~
keybind = ctrl+3=text:\x1b[27;5;51~
keybind = ctrl+4=text:\x1b[27;5;52~
keybind = ctrl+5=text:\x1b[27;5;53~
keybind = ctrl+6=text:\x1b[27;5;54~
keybind = ctrl+7=text:\x1b[27;5;55~
keybind = ctrl+8=text:\x1b[27;5;56~
keybind = ctrl+9=text:\x1b[27;5;57~

# Opt-` -> Esc+` (tmux M-` = switch to last session). Needed because Option+`
# is a dead-key grave accent on the US layout, so it isn't sent as Alt.
keybind = alt+grave_accent=text:\x1b`

# Opt-Tab / Opt-Shift-Tab -> tmux M-Tab / M-BTab (next/previous window)
keybind = alt+tab=text:\x1b\x09
keybind = alt+shift+tab=text:\x1b\x1b[Z

# Opt-h/l -> tmux M-h/M-l (previous/next window), Opt-H/L -> M-H/M-L (move the
# window). These type "˙ ¬ Ó Ò" on the US layout, so send Alt explicitly.
keybind = alt+h=text:\x1bh
keybind = alt+l=text:\x1bl
keybind = alt+shift+h=text:\x1bH
keybind = alt+shift+l=text:\x1bL

# Opt-j/k -> tmux M-j/M-k (next/previous session), Opt-J/K -> M-J/M-K (take the
# current window along)
keybind = alt+j=text:\x1bj
keybind = alt+k=text:\x1bk
keybind = alt+shift+j=text:\x1bJ
keybind = alt+shift+k=text:\x1bK

macos-titlebar-style = tabs
