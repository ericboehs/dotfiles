# This directory is published. Track only reviewed, reproducible configuration.
*
!.gitignore
!README.md
!settings.*.json
!models.*.json
!keybindings.json
!approval-guardian.json
!web-search.json
!extensions/
extensions/*
!extensions/*.ts
# One level of subdirectory, .ts only. pi discovers extensions/<name>/index.ts
# as an extension and an import like "./lib/schedule-core.ts" resolves inside
# the same directory — and that directory is now published as a whole symlink,
# so a helper left untracked here is not merely missing on another host: pi
# aborts the entire launch when an extension's import cannot resolve.
!extensions/*/
!extensions/*/*.ts

# Extension tooling (not linked into ~/.pi/agent — see tsconfig.json).
# node_modules/ is symlinks to the global pi, created by bin/pi-ext-check.
!package.json
!tsconfig.json
!test/
test/*
!test/*.mjs
