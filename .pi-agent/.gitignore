# This directory is published. Track only reviewed, reproducible configuration.
*
!.gitignore
!README.md
!settings.*.json
!models.*.json
!keybindings.json
!AGENTS.md
!approval-guardian.json
!web-search.json

# Prompt templates. Zero token cost until invoked via /<name>.
!prompts/
prompts/*
!prompts/*.md

# Design skills vendored verbatim from anthropics/skills (Apache 2.0) by
# bin/artifact-skills-sync. Text only -- no fonts or binaries. Read on demand
# by /artifact, so they cost nothing until that prompt runs.
!artifact-skills/
artifact-skills/*
!artifact-skills/MANIFEST
!artifact-skills/*/
artifact-skills/*/*
!artifact-skills/*/SKILL.md
!artifact-skills/*/LICENSE.txt

# html-plan vendored from anthropics/claude-plugins-community. Text only.
# Read on demand by /html-plan, so it costs nothing until that prompt runs.
# runtime/htmlplan.js has one local patch (copy toast says Pi, not Claude).
!html-plan/
html-plan/*
!html-plan/SKILL.md
!html-plan/LICENSE
!html-plan/MANIFEST
!html-plan/UPSTREAM.plugin.json
!html-plan/references/
html-plan/references/*
!html-plan/references/blocks.md
!html-plan/runtime/
html-plan/runtime/*
!html-plan/runtime/htmlplan.css
!html-plan/runtime/htmlplan.js
!html-plan/runtime/pack.mjs
!html-plan/examples/
html-plan/examples/*
!html-plan/examples/scheduled-send.html

!extensions/
extensions/*
!extensions/*.ts
# Generated and updated by `herdr integration install pi`; bootstrap recreates it.
extensions/herdr-agent-state.ts
# One level of subdirectory, .ts only. pi discovers extensions/<name>/index.ts
# as an extension and an import like "./lib/helper.ts" resolves inside
# the same directory — and that directory is now published as a whole symlink,
# so a helper left untracked here is not merely missing on another host: pi
# aborts the entire launch when an extension's import cannot resolve.
!extensions/*/
!extensions/*/*.ts
# .mjs files pi does not import: the search-chain scoring harness
# (web-providers/eval.mjs, run by hand before a backend change; the numbers in
# web-providers/README.md came out of it) and the canvas daemon and browser
# page (canvas/daemon.mjs, canvas/page.mjs, spawned and served by canvas.ts).
!extensions/*/*.mjs

# Extension tooling (not linked into ~/.pi/agent — see tsconfig.json).
# node_modules/ is symlinks to the global pi, created by bin/pi-ext-check.
!package.json
!package-lock.json
!tsconfig.json
!test/
test/*
!test/*.mjs
