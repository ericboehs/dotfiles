# This directory is published. Track only reviewed, reproducible configuration.
*
!.gitignore
!README.md
!settings.*.json
!models.*.json
!keybindings.json
!approval-guardian.json
!web-search.json

# Prompt templates. Zero token cost until invoked via /<name>.
!prompts/
prompts/*
!prompts/*.md

# Design skills vendored verbatim from anthropics/skills (Apache 2.0) by
# bin/artifact-skills-sync. Text only -- no fonts or binaries. Read on demand
# by /artifact, so they cost nothing until that prompt runs.
!artifact-skills/
artifact-skills/*
!artifact-skills/MANIFEST
!artifact-skills/*/
artifact-skills/*/*
!artifact-skills/*/SKILL.md
!artifact-skills/*/LICENSE.txt

!extensions/
extensions/*
!extensions/*.ts
# One level of subdirectory, .ts only. pi discovers extensions/<name>/index.ts
# as an extension and an import like "./lib/helper.ts" resolves inside
# the same directory — and that directory is now published as a whole symlink,
# so a helper left untracked here is not merely missing on another host: pi
# aborts the entire launch when an extension's import cannot resolve.
!extensions/*/
!extensions/*/*.ts

# Extension tooling (not linked into ~/.pi/agent — see tsconfig.json).
# node_modules/ is symlinks to the global pi, created by bin/pi-ext-check.
!package.json
!package-lock.json
!tsconfig.json
!test/
test/*
!test/*.mjs
