{
  "lastChangelogVersion": "1.3.0",
  "packages": [
    "../../Code/github.com/ericboehs/pi-boehsline",
    "../../Code/github.com/ericboehs/pi-boehsline-va",
    "git:github.com/ericboehs/agent-notify@3787106d66f79493d7301995e06c2e537c091a4f",
    "npm:pi-claude-subscription-connector"
  ],
  "skills": [
    "~/Code/github.com/ericboehs/agent-plugins/plugins/git-utils/skills",
    "~/Code/github.com/ericboehs/agent-plugins/plugins/gist/skills",
    "~/Code/github.com/ericboehs/agent-plugins/plugins/code-lint/skills",
    "~/Code/github.com/ericboehs/agent-plugins/plugins/copy-for-slack/skills",
    "~/Code/github.com/ericboehs/agent-plugins/plugins/gh-copilot-review/skills",
    "~/Code/github.com/ericboehs/agent-plugins/plugins/watch-ci/skills",
    "~/Code/github.com/ericboehs/agent-plugins/plugins/agent-desktop/skills",
    "~/Code/github.com/ericboehs/agent-plugins/plugins/gh-actions-security/skills",
    "~/Code/github.com/ericboehs/agent-plugins/plugins/icloud-downloads/skills",
    "~/Code/github.com/ericboehs/agent-plugins/plugins/md-to-pdf/skills",
    "~/Code/github.com/ericboehs/agent-plugins/plugins/x-fetch/skills",
    "~/Code/github.com/ericboehs/agent-plugins/plugins/pr-review/skills",
    "~/Code/github.com/ericboehs/agent-plugins/plugins/security-review/skills"
  ],
  "prompts": [
    "~/Code/github.com/ericboehs/claude-config/prompts",
    "~/Code/github.com/ericboehs/agent-plugins/pi/prompts"
  ],
  "defaultProvider": "github-copilot",
  "defaultModel": "claude-opus-5.5",
  "defaultThinkingLevel": "xhigh",
  "modelThinkingLevels": {
    "github-copilot/claude-opus-5.5": "medium",
    "github-copilot/claude-sonnet-5.5": "high",
    "openrouter/z-ai/glm-5.3-flash@preset/ox-alpha": "max",
    "ollama/glm-5.3-flash": "max",
    "inco/deepseek-v4.1-flash:fast": "high"
  },
  "theme": "light/dark",
  "steeringMode": "all",
  "defaultTools": [
    "+codemode"
  ],
  "transport": "auto",
  "quietStartup": false,
  "defaultProjectTrust": "always",
  "doubleEscapeAction": "tree",
  "treeFilterMode": "default",
  "warnings": {
    "anthropicExtraUsage": false
  },
  "enabledModels": [
    "xai/grok-4.7",
    "github-copilot/claude-opus-5.5",
    "opencode-go/glm-5.3",
    "opencode-go/deepseek-v4.1-flash"
  ],
  "retry": {
    "enabled": true,
    "maxRetries": 10,
    "baseDelayMs": 2000
  },
  "compaction": {
    "modelOverrides": {
      "github-copilot/claude-opus-5.5": {
        "reserveTokens": 48000
      }
    }
  },
  "showHardwareCursor": true,
  "editorPaddingX": 1,
  "terminal": {
    "showTerminalProgress": true
  },
  "tuiMode": "fullscreen",
  "fullscreenScrollbar": "auto",
  "fullscreenExitOutput": "resume-hint",
  "enableInstallTelemetry": false,
  "hideThinkingBlock": false
}
