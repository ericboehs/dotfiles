{
  "defaultThinkingLevel": "xhigh",
  "theme": "light/dark",
  "steeringMode": "all",
  "transport": "auto",
  "defaultProjectTrust": "always",
  "doubleEscapeAction": "tree",
  "treeFilterMode": "default",
  "editorPaddingX": 1,
  "terminal": {
    "showTerminalProgress": true
  },
  "enableInstallTelemetry": false,
  "defaultProvider": "github-copilot",
  "defaultModel": "claude-opus-5",
  "packages": [
    "git:github.com/ericboehs/pi-approval-guardian@bde157396387766d570a93eecc0f0489f41f0935",
    "npm:@nicknisi/pi-stash",
    "git:github.com/ericboehs/pi-claude-link@78e01168ddccbf1f5ef3a3474b70cf030a6bd551",
    "git:github.com/ericboehs/pi-context"
  ],
  "extensions": [
    "~/Code/github.com/ericboehs/claude-plugins/pi/extensions/code-lint.ts",
    "~/Code/github.com/ericboehs/claude-notify/extensions/pi-notify.ts"
  ]
}
