{
  "defaultThinkingLevel": "xhigh",
  "theme": "light/dark",
  "steeringMode": "all",
  "transport": "auto",
  "defaultProjectTrust": "always",
  "doubleEscapeAction": "tree",
  "treeFilterMode": "default",
  "editorPaddingX": 1,
  "terminal": {
    "showTerminalProgress": true
  },
  "enableInstallTelemetry": false,
  "defaultProvider": "github-copilot",
  "defaultModel": "claude-opus-5.5",
  "modelThinkingLevels": {
    "github-copilot/claude-opus-5.5": "medium",
    "github-copilot/claude-sonnet-5.5": "high"
  },
  "enabledModels": [
    "github-copilot/claude-opus-5.5",
    "github-copilot/claude-sonnet-5.5"
  ],
  "compaction": {
    "modelOverrides": {
      "github-copilot/claude-opus-5.5": {
        "reserveTokens": 48000
      }
    }
  },
  "packages": [
    "git:github.com/ericboehs/pi-approval-guardian@384d523123d006bfa7e1445ce29190f14c832e64",
    "git:github.com/ericboehs/pi-context@a00fdbf97a444448db180f5e5f4c6118bf7c935a",
    "git:github.com/ericboehs/pi-scheduler@787fa145547e9dd98e14e651e5ce55ac5d697535",
    "git:github.com/ericboehs/agent-notify@3787106d66f79493d7301995e06c2e537c091a4f",
    "git:github.com/ericboehs/pi-agent-link@d094743a18a9a099bac48ee03bb795e886260588"
  ],
  "extensions": [
    "~/Code/github.com/ericboehs/agent-plugins/pi/extensions/code-lint.ts",
    "-extensions/web-chat.ts"
  ],
  "lastChangelogVersion": "0.85.1"
}
