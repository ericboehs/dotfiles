{
  "defaultThinkingLevel": "xhigh",
  "theme": "light/dark",
  "steeringMode": "all",
  "transport": "auto",
  "defaultProjectTrust": "always",
  "doubleEscapeAction": "tree",
  "treeFilterMode": "default",
  "editorPaddingX": 1,
  "terminal": {
    "showTerminalProgress": true
  },
  "enableInstallTelemetry": false,
  "defaultProvider": "github-copilot",
  "defaultModel": "claude-opus-5.5",
  "modelThinkingLevels": {
    "github-copilot/claude-opus-5.5": "medium",
    "github-copilot/claude-sonnet-5.5": "high"
  },
  "enabledModels": [
    "github-copilot/claude-opus-5.5",
    "github-copilot/claude-sonnet-5.5"
  ],
  "compaction": {
    "modelOverrides": {
      "github-copilot/claude-opus-5.5": {
        "reserveTokens": 48000
      }
    }
  },
  "packages": [
    "git:github.com/ericboehs/pi-boehsline@3d10a87378243affd269b4b9ab6c8542308f0418",
    "git:github.com/ericboehs/pi-boehsline-va@7c9afaf2fd93b31fae4fd3b28f6b144a373ece48",
    "git:github.com/ericboehs/agent-notify@3787106d66f79493d7301995e06c2e537c091a4f"
  ],
  "lastChangelogVersion": "0.85.1"
}
