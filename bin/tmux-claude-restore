#!/usr/bin/env bash
# tmux-claude-restore - Restore tmux session from saved Claude session state
#
# Recreates tmux windows and launches Claude with --resume for each saved
# session. Windows whose working directory or transcript has disappeared are
# skipped with a warning rather than silently started in the wrong place.
#
# Usage: tmux-claude-restore [SESSION_NAME] [OPTIONS]
#   SESSION_NAME defaults to "future"
#   --dry-run, -n   Show what would be done without executing
#   --list, -l      List saved sessions
#   --force, -f     Restore even when cwd/transcript checks fail

set -euo pipefail

SESSION_NAME=""
DRY_RUN=false
LIST_MODE=false
FORCE=false

while [[ $# -gt 0 ]]; do
  case $1 in
    --dry-run|-n) DRY_RUN=true; shift ;;
    --list|-l) LIST_MODE=true; shift ;;
    --force|-f) FORCE=true; shift ;;
    --help|-h)
      # Print the header comment block, stopping at the first non-comment line.
      awk 'NR>1 { if (/^#/) { sub(/^# ?/, ""); print } else { exit } }' "$0"
      exit 0
      ;;
    -*) echo "Error: unknown option '$1'" >&2; exit 1 ;;
    *) SESSION_NAME="$1"; shift ;;
  esac
done

SAVE_DIR="$HOME/.config/tmux-claude"
PROJECTS_DIR="$HOME/.claude/projects"

for dep in tmux jq; do
  command -v "$dep" >/dev/null || { echo "Error: '$dep' is required" >&2; exit 1; }
done

if $LIST_MODE; then
  echo "Saved tmux-claude sessions:"
  shopt -s nullglob
  found_any=false
  for f in "$SAVE_DIR"/*.json; do
    found_any=true
    jq -r --arg name "$(basename "$f" .json)" \
      '"  \($name)  (\(.windows | length) windows, saved \(.saved_at))"' "$f" 2>/dev/null \
      || echo "  $(basename "$f" .json)  (unreadable)"
  done
  $found_any || echo "  (none)"
  exit 0
fi

SESSION_NAME="${SESSION_NAME:-future}"
SAVE_FILE="$SAVE_DIR/$SESSION_NAME.json"

if [ ! -f "$SAVE_FILE" ]; then
  echo "Error: No saved state for session '$SESSION_NAME'" >&2
  echo "Run 'tmux-claude-restore --list' to see available saves" >&2
  exit 1
fi

jq -e '.windows | type == "array"' "$SAVE_FILE" >/dev/null 2>&1 \
  || { echo "Error: $SAVE_FILE is not valid tmux-claude state" >&2; exit 1; }

# Encode a cwd the way Claude names its project dirs (see tmux-claude-save).
cwd_to_project_dir() {
  printf '%s/%s\n' "$PROJECTS_DIR" "$(printf '%s' "$1" | sed 's/[^a-zA-Z0-9-]/-/g')"
}

transcript_exists() {
  local cwd="$1" id="$2"
  [ -f "$(cwd_to_project_dir "$cwd")/$id.jsonl" ] && return 0
  # Session may have been recorded under a different project dir.
  find "$PROJECTS_DIR" -maxdepth 2 -name "$id.jsonl" -print -quit 2>/dev/null | grep -q .
}

echo "Restoring tmux session: $SESSION_NAME"
echo ""

session_exists=false
if tmux has-session -t "$SESSION_NAME" 2>/dev/null; then
  session_exists=true
  echo "Warning: tmux session '$SESSION_NAME' already exists"
  $DRY_RUN || echo "  Adding restored windows to the existing session"
  echo ""
fi

echo "Saved at: $(jq -r '.saved_at' "$SAVE_FILE")"
echo "Windows to restore: $(jq -r '.windows | length' "$SAVE_FILE")"
echo ""

created=0
skipped=0
first_window=true

while IFS= read -r win; do
  # Parse per window. Tab-separated output is not safe here: tab is an IFS
  # whitespace character, so bash collapses runs of tabs and an empty field
  # (e.g. a missing session_name) would shift every later field left.
  idx=$(jq -r '.window_index // ""' <<<"$win")
  cwd=$(jq -r '.cwd // ""' <<<"$win")
  session_id=$(jq -r '.session_id // ""' <<<"$win")
  session_name=$(jq -r '.session_name // ""' <<<"$win")
  skip_perms=$(jq -r '.dangerously_skip_permissions | tostring' <<<"$win")
  method=$(jq -r '.detection_method // ""' <<<"$win")

  # Build the claude command.
  cmd="claude"
  [ "$skip_perms" = "true" ] && cmd="$cmd --dangerously-skip-permissions"
  [ -n "$session_id" ] && cmd="$cmd --resume $session_id"

  case "$method" in
    claude_state) confidence="★" ;;
    command_args) confidence="●" ;;
    *) confidence="○" ;;
  esac

  label="Window $idx"
  [ -n "$session_name" ] && label="$label ($session_name)"

  # Pre-flight checks. tmux silently falls back to $HOME when -c is missing,
  # which would resume a session against the wrong project, so verify first.
  problem=""
  if [ -z "$cwd" ] || [ ! -d "$cwd" ]; then
    problem="working directory is gone: ${cwd:-(unset)}"
  elif [ -z "$session_id" ]; then
    problem="no session ID was captured (would start a brand-new conversation)"
  elif ! transcript_exists "$cwd" "$session_id"; then
    problem="transcript $session_id.jsonl no longer exists"
  fi

  if [ -n "$problem" ] && ! $FORCE; then
    echo "  ⚠ SKIP $label: $problem"
    skipped=$((skipped + 1))
    continue
  fi
  [ -n "$problem" ] && echo "  ! $label: $problem (forced)"

  echo "  $confidence $label: (cd $cwd) $cmd"
  $DRY_RUN && continue

  # Create the window and capture its real index atomically; never assume a
  # base-index or read back the session's "current" window.
  if $first_window && ! $session_exists; then
    new_idx=$(tmux new-session -d -P -F '#{window_index}' \
      -s "$SESSION_NAME" -c "$cwd" -x 200 -y 50)
  else
    new_idx=$(tmux new-window -t "$SESSION_NAME" -P -F '#{window_index}' -c "$cwd")
  fi
  first_window=false

  [ -n "$session_name" ] && tmux rename-window -t "$SESSION_NAME:$new_idx" "$session_name"

  # Confirm the pane really landed in the intended directory.
  actual=$(tmux display-message -t "$SESSION_NAME:$new_idx" -p '#{pane_start_path}')
  if [ "$actual" != "$cwd" ]; then
    echo "    ⚠ tmux started this window in '$actual' instead of '$cwd'" >&2
  fi

  tmux send-keys -t "$SESSION_NAME:$new_idx" "$cmd" Enter
  created=$((created + 1))
done < <(jq -c '.windows[]' "$SAVE_FILE")

echo ""
echo "Legend: ★ = Claude session state, ● = from command args, ○ = fallback guess"
if $DRY_RUN; then
  echo "(dry run — no changes made; $skipped would be skipped)"
else
  echo "Restored $created window(s), skipped $skipped."
  [ "$skipped" -gt 0 ] && echo "Re-run with --force to restore skipped windows anyway."
  [ "$created" -gt 0 ] && echo "Attach with: tmux attach -t $SESSION_NAME"
fi
exit 0
