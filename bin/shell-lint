#!/usr/bin/env bash

# Shellcheck the repo's shell scripts.
# Usage: shell-lint [-h|--help] [--list]
#
# Every tracked bash/sh script is checked strictly. This started as a ratchet:
# 71 of 104 scripts were clean and the other 33 were exempted by name in
# .shellcheck-legacy, held to parse errors only, on a list that could only
# shrink. The list reached zero, so the exemption machinery is gone — it is one
# `git revert` away if a large script ever arrives dirty.

set -euo pipefail

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  echo "Usage: $(basename "$0") [--list]"
  echo ""
  echo "Shellcheck every tracked shell script."
  echo "--list prints the discovered scripts instead of checking them."
  exit 0
fi

# bin/ is symlinked to ~/bin, so resolve the real script location.
target="${BASH_SOURCE[0]}"
while [ -L "$target" ]; do
  link="$(readlink "$target")"
  case "$link" in
    /*) target="$link" ;;
    *) target="$(dirname "$target")/$link" ;;
  esac
done
# -P for the same reason as bin/pi-ext-check: invoked through the ~/bin symlink,
# a logical cd would strip the `..` textually and land in $HOME.
REPO="$(cd -P "$(dirname "$target")/.." && pwd)"
cd "$REPO"

RED='\033[0;31m'
GREEN='\033[0;32m'
NC='\033[0m'

if ! command -v shellcheck >/dev/null; then
  echo -e "${RED}❌ shellcheck is not on PATH${NC}" >&2
  exit 1
fi

# Tracked files only. An untracked scratch script in bin/ is nobody else's
# problem, and it would make this pass or fail depending on the working tree.
mapfile -t tracked < <(git ls-files bin .tmux .claude)

strict=()
skipped_zsh=0

for file in "${tracked[@]}"; do
  # Skips dangling symlinks as well as directories: bin/ has symlinks into
  # sibling repos that only resolve where those repos are checked out.
  [ -f "$file" ] || continue
  # Language by shebang, not by extension: bin/ holds ruby, node, python, swift
  # and osascript too. Files with no shebang are skipped because guessing wrong
  # produces a wall of nonsense.
  #
  # Read bounded and strip NULs: bin/claude-code-proxy-or is a tracked symlink
  # to a Mach-O binary, and bash warns about the null bytes in a command
  # substitution otherwise.
  shebang="$(head -c 512 "$file" 2>/dev/null | LC_ALL=C tr -d '\0' | head -1)"
  case "$shebang" in
    '#!'*zsh*) skipped_zsh=$((skipped_zsh + 1)); continue ;;
    '#!'*bash* | '#!'*/bin/sh | '#!'*env\ sh) ;;
    *) continue ;;
  esac
  strict+=("$file")
done

if [[ "${1:-}" == "--list" ]]; then
  printf '%s\n' "${strict[@]}"
  exit 0
fi

# "Nothing to check" must not read as success: a bad path or a shebang
# convention change would otherwise print a green check for doing nothing.
if [ ${#strict[@]} -eq 0 ]; then
  echo -e "${RED}❌ no shell scripts found to check${NC}" >&2
  exit 1
fi

status=0

echo "Checking ${#strict[@]} scripts ($skipped_zsh zsh skipped)..."
if shellcheck "${strict[@]}"; then
  echo -e "${GREEN}✅ shellcheck clean${NC}"
else
  echo -e "${RED}❌ shellcheck found problems${NC}" >&2
  status=1
fi

exit "$status"
