#!/usr/bin/env bash

# Host-gated links from .dotfiles-hosts: the things that belong on some
# machines only, which [dotfiles] (link everywhere) cannot express.
#
#   dotfiles-host-links            print "target<TAB>source" for this host
#   dotfiles-host-links --all      print every source the manifest names, for
#                                  any host (dotfiles-link-check's coverage)
#   dotfiles-host-links --apply    converge: link this host's rows, load
#                                  LaunchAgents, unlink rows meant elsewhere
#
# --apply is what bootstrap:launchd runs. Its rules:
#
#   - A real file where a link belongs is replaced silently when its bytes
#     match the tracked source (the hand-copied plists this replaced), and
#     renamed to .bak otherwise, as bootstrap does for [dotfiles].
#   - A LaunchAgent is (re)loaded only when its definition changed or it is
#     not loaded. Swapping an identical copy for a link changes nothing launchd
#     cares about, and reloading would kill a running job: a mail-sync killed
#     mid-run leaves a lock the next run reports as an incident.
#   - A link into this repo that the manifest no longer gives this host is
#     unloaded and removed, so dropping a host from a row actually stops the
#     job there instead of leaving it running from a stale link.

set -euo pipefail

root="${PI_DOTFILES_ROOT:-$(cd -P "$(dirname "$0")" && pwd)}"
root="${root%/bin}"
manifest="$root/.dotfiles-hosts"
agents="$HOME/Library/LaunchAgents"

resolve_host() {
  local host="${PI_SETTINGS_HOST:-}"
  if [[ -z "$host" && -f "$root/.pi-agent/host" ]]; then
    host="$(tr -d '[:space:]' < "$root/.pi-agent/host")"
  fi
  [[ -n "$host" ]] || host="$(hostname -s | tr '[:upper:]' '[:lower:]')"
  printf '%s' "$host"
}

# Every row as "wanted<TAB>target<TAB>source", wanted being 1 for this host.
rows() {
  local host source target hosts h wanted
  host="$(resolve_host)"
  [[ -f "$manifest" ]] || return 0
  while read -r source target hosts; do
    [[ -z "$source" || "$source" == \#* ]] && continue
    target="${target/#\~\//$HOME/}"
    [[ "$target" == */ ]] && target="$target${source##*/}"
    wanted=0
    for h in $hosts; do [[ "$h" == "$host" ]] && wanted=1; done
    printf '%s\t%s\t%s\n' "$wanted" "$target" "$root/$source"
  done < "$manifest"
}

is_agent() { [[ "$1" == "$agents/"*.plist ]]; }
label_of() { plutil -extract Label raw -o - "$1"; }
domain="gui/$(id -u)"

load() {
  local target="$1" label
  label="$(label_of "$target")"
  launchctl bootout "$domain/$label" 2>/dev/null || true
  launchctl bootstrap "$domain" "$target"
  echo "dotfiles-host-links: loaded $label"
}

apply() {
  local wanted target source changed label status=0
  while IFS=$'\t' read -r wanted target source; do
    if [[ "$wanted" != 1 ]]; then
      # Only undo what this script made: a link to exactly this source.
      if [[ -L "$target" && "$target" -ef "$source" ]]; then
        if is_agent "$target"; then
          launchctl bootout "$domain/$(label_of "$target")" 2>/dev/null || true
        fi
        rm "$target"
        echo "dotfiles-host-links: removed $target (not for this host)"
      fi
      continue
    fi

    if [[ ! -e "$source" ]]; then
      echo "dotfiles-host-links: $source is in .dotfiles-hosts but missing" >&2
      status=1
      continue
    fi

    changed=0
    mkdir -p "$(dirname "$target")"
    if [[ -L "$target" && "$target" -ef "$source" ]]; then
      :
    elif [[ -L "$target" ]]; then
      changed=1
    elif [[ -e "$target" ]]; then
      if ! cmp -s "$target" "$source"; then
        mv "$target" "$target.bak"
        echo "dotfiles-host-links: kept the previous $target at ${target##*/}.bak" >&2
        changed=1
      fi
    else
      changed=1
    fi
    if [[ ! -L "$target" || ! "$target" -ef "$source" ]]; then
      ln -sfn "$source" "$target"
      echo "dotfiles-host-links: linked $target"
    fi

    if is_agent "$target"; then
      label="$(label_of "$source")"
      if [[ "$changed" == 1 ]] || ! launchctl print "$domain/$label" >/dev/null 2>&1; then
        load "$target" || status=1
      fi
    fi
  done < <(rows)
  return "$status"
}

case "${1:-}" in
  "") rows | awk -F'\t' '$1 == 1 { print $2 "\t" $3 }' ;;
  --all) rows | cut -f3 ;;
  --apply)
    if [[ "$(uname)" != Darwin ]]; then
      echo "dotfiles-host-links: not macOS — nothing to link" >&2
      exit 0
    fi
    apply
    ;;
  -h | --help) sed -n '3,25p' "$0" | sed 's/^# \{0,1\}//' ;;
  *)
    echo "usage: dotfiles-host-links [--all|--apply]" >&2
    exit 2
    ;;
esac
