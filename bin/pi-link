#!/usr/bin/env python3
"""Control live Pi coding-agent sessions via pi-agent-link (Claude cross-session socks).

Commands:
  list                         Live peers + matching tmux panes
  send <target> <message...>   Fire-and-forget inject
  ask  <target> <message...>   Inject, wait for reply (ask-mode + capture fallback)
  capture <tmux-target>        Capture pane text (e.g. code:8.0)

Target may be peer name (tmux-pi-prefill), pid, sessionId, or tmux pane (code:8.0).
Never uses Grok API — model work stays on whatever provider that Pi session uses.
"""
from __future__ import annotations

import argparse
import glob
import json
import os
import re
import socket
import subprocess
import sys
import time
import uuid
from pathlib import Path

HOME = Path.home()
REGISTRY = HOME / ".claude" / "sessions"
CC_SOCKS = Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp")) / "cc-socks"
GROK_SOCK = CC_SOCKS / f"grok-bot-pi-link-{os.getpid()}.sock"
TAG = "cross-session-message"


def sock_live(path: str, timeout: float = 0.25) -> bool:
    try:
        s = socket.socket(socket.AF_UNIX)
        s.settimeout(timeout)
        s.connect(path)
        s.close()
        return True
    except OSError:
        return False


def load_peers() -> list[dict]:
    rows = []
    if not REGISTRY.is_dir():
        return rows
    for f in REGISTRY.glob("*.json"):
        if not re.match(r"^\d+\.json$", f.name):
            continue
        try:
            d = json.loads(f.read_text())
        except Exception:
            continue
        sock = d.get("messagingSocketPath") or ""
        if not sock or not sock_live(sock):
            continue
        rows.append(
            {
                "pid": d.get("pid"),
                "name": d.get("name") or f"pid-{d.get('pid')}",
                "cwd": d.get("cwd") or "?",
                "status": d.get("status") or "unknown",
                "sessionId": d.get("sessionId"),
                "sock": sock,
                "entrypoint": d.get("entrypoint"),
            }
        )
    rows.sort(key=lambda r: (r["name"], r["pid"] or 0))
    return rows


def tmux_panes() -> list[dict]:
    try:
        out = subprocess.check_output(
            [
                "tmux",
                "list-panes",
                "-a",
                "-F",
                "#{session_name}:#{window_index}.#{pane_index}\t#{pane_title}\t#{pane_pid}\t#{pane_current_path}\t#{pane_current_command}",
            ],
            text=True,
        )
    except (subprocess.CalledProcessError, FileNotFoundError):
        return []
    panes = []
    for line in out.splitlines():
        parts = line.split("\t")
        if len(parts) < 5:
            continue
        target, title, pane_pid, path, cmd = parts[:5]
        panes.append(
            {
                "tmux": target,
                "title": title,
                "pane_pid": int(pane_pid) if pane_pid.isdigit() else None,
                "path": path,
                "cmd": cmd,
            }
        )
    return panes


def pi_pid_for_pane(pane_pid: int | None) -> int | None:
    """Walk up from pane shell/node to find a process that owns a cc-sock."""
    if not pane_pid:
        return None
    # Map sock basenames (pid.sock) for quick membership
    sock_pids = set()
    if CC_SOCKS.is_dir():
        for p in CC_SOCKS.glob("*.sock"):
            if p.stem.isdigit():
                sock_pids.add(int(p.stem))
    # Check pane pid and ancestors via ps
    pid = pane_pid
    seen = set()
    while pid and pid not in seen:
        seen.add(pid)
        if pid in sock_pids:
            return pid
        try:
            ppid = int(
                subprocess.check_output(["ps", "-o", "ppid=", "-p", str(pid)], text=True).strip()
                or "0"
            )
        except Exception:
            break
        pid = ppid if ppid > 1 else None
    # Fallback: match by cwd/name later
    return None


def enrich(peers: list[dict], panes: list[dict]) -> list[dict]:
    by_pid = {p["pid"]: p for p in peers if p.get("pid")}
    by_name = {p["name"]: p for p in peers}
    for pane in panes:
        title = pane["title"] or ""
        if "π" not in title and not re.match(r"^pi:", title):
            continue
        peer = None
        # 1) pane process (or ancestor) owns a cc-sock
        ppid = pi_pid_for_pane(pane["pane_pid"])
        if ppid:
            peer = by_pid.get(ppid)
        # 2) title form: "π - <name> - <dir>"
        if not peer:
            m = re.match(r"π\s*-\s*(.+?)\s*-\s*", title)
            if m:
                name = m.group(1).strip()
                peer = by_name.get(name)
                if not peer:
                    for p in peers:
                        if p["name"] == name or name.startswith(p["name"]) or p["name"].startswith(name):
                            peer = p
                            break
        if peer:
            peer["tmux"] = pane["tmux"]
            peer["title"] = title
    return peers


def resolve(target: str, peers: list[dict]) -> dict:
    # tmux pane → peer
    if re.match(r"^[\w-]+:\d+\.\d+$", target):
        for p in peers:
            if p.get("tmux") == target:
                return p
        raise SystemExit(f"no live Pi peer mapped to tmux pane {target}")
    if target.isdigit():
        for p in peers:
            if str(p.get("pid")) == target:
                return p
        raise SystemExit(f"no live peer with pid {target}")
    exact = [p for p in peers if p["name"] == target]
    if len(exact) == 1:
        return exact[0]
    if len(exact) > 1:
        raise SystemExit(
            f"ambiguous name {target!r}; use pid: "
            + ", ".join(f"{p['name']}({p['pid']})" for p in exact)
        )
    pfx = [p for p in peers if p["name"].startswith(target)]
    if len(pfx) == 1:
        return pfx[0]
    if len(pfx) > 1:
        raise SystemExit(
            f"ambiguous prefix {target!r}: " + ", ".join(p["name"] for p in pfx)
        )
    raise SystemExit(
        f"no live peer matches {target!r}. Run: pi-link list"
    )


def build_envelope(body: str, from_addr: str, from_name: str, from_mode: str | None) -> str:
    attrs = [f'from="{from_addr}"', f'from-name="{from_name}"']
    if from_mode:
        attrs.append(f'from-mode="{from_mode}"')
    return f"<{TAG} {' '.join(attrs)}>\n{body}\n</{TAG}>"


def send_frame(sock_path: str, frame: dict, timeout: float = 5.0) -> None:
    data = (json.dumps(frame) + "\n").encode()
    s = socket.socket(socket.AF_UNIX)
    s.settimeout(timeout)
    s.connect(sock_path)
    s.sendall(data)
    s.close()


def inject(peer: dict, message: str, *, ask: bool) -> str:
    from_addr = f"uds:{GROK_SOCK}"
    from_mode = "ask" if ask else None
    content = build_envelope(message, from_addr, "Grok Bot", from_mode)
    frame = {
        "msgV": 1,
        "msg_id": str(uuid.uuid4()),
        "type": "user",
        "priority": "next",
        "from": from_addr,
        "message": {"role": "user", "content": content},
    }
    send_frame(peer["sock"], frame)
    return frame["msg_id"]


def capture_pane(tmux_target: str, lines: int = 120) -> str:
    return subprocess.check_output(
        ["tmux", "capture-pane", "-t", tmux_target, "-p", "-S", f"-{lines}"],
        text=True,
    )


def cmd_list(_: argparse.Namespace) -> int:
    peers = enrich(load_peers(), tmux_panes())
    if not peers:
        print("No live Pi peers (no sockets under /tmp/cc-socks).")
        return 1
    print(f"{'NAME':<28} {'PID':>6} {'STATUS':<10} {'TMUX':<12} CWD")
    for p in peers:
        print(
            f"{p['name']:<28} {p.get('pid') or '-':>6} {p['status']:<10} "
            f"{p.get('tmux') or '-':<12} {p['cwd']}"
        )
        # Flag likely Grok-provider panes from title/path heuristics? leave to skill.
    return 0


def cmd_capture(args: argparse.Namespace) -> int:
    print(capture_pane(args.target, args.lines), end="" if False else "")
    return 0


def cmd_send(args: argparse.Namespace) -> int:
    peers = enrich(load_peers(), tmux_panes())
    peer = resolve(args.target, peers)
    if peer.get("status") not in ("idle", "unknown") and not args.force:
        print(
            f"peer {peer['name']} status={peer['status']}; pass --force to inject anyway",
            file=sys.stderr,
        )
        return 2
    msg = " ".join(args.message)
    mid = inject(peer, msg, ask=False)
    print(f"sent {mid} -> {peer['name']} (pid {peer['pid']}) tmux={peer.get('tmux')}")
    return 0


def wait_reply_via_capture(peer: dict, marker: str, timeout: float) -> str:
    tmux = peer.get("tmux")
    if not tmux:
        raise SystemExit("no tmux pane mapped; cannot capture reply — use send + manual capture")
    deadline = time.time() + timeout
    baseline = capture_pane(tmux)
    # Wait until status idle again and new content after marker
    while time.time() < deadline:
        st = "?"
        try:
            reg = REGISTRY / f"{peer['pid']}.json"
            if reg.exists():
                st = json.loads(reg.read_text()).get("status", "?")
        except Exception:
            pass
        text = capture_pane(tmux)
        if marker in text and st == "idle" and text != baseline:
            # Return tail after last marker occurrence
            idx = text.rfind(marker)
            return text[idx:]
        time.sleep(0.5)
    return capture_pane(tmux)


def listen_ask_reply(timeout: float) -> str | None:
    """Listen on GROK_SOCK for a relayed peer reply (ask-mode)."""
    CC_SOCKS.mkdir(parents=True, exist_ok=True)
    if GROK_SOCK.exists():
        GROK_SOCK.unlink()
    srv = socket.socket(socket.AF_UNIX)
    srv.bind(str(GROK_SOCK))
    srv.listen(5)
    srv.settimeout(1.0)
    deadline = time.time() + timeout
    buf = b""
    try:
        while time.time() < deadline:
            try:
                conn, _ = srv.accept()
            except socket.timeout:
                continue
            conn.settimeout(2.0)
            try:
                while True:
                    chunk = conn.recv(65536)
                    if not chunk:
                        break
                    buf += chunk
                    if b"\n" in buf:
                        break
            finally:
                conn.close()
            for line in buf.split(b"\n"):
                if not line.strip():
                    continue
                try:
                    frame = json.loads(line)
                except json.JSONDecodeError:
                    continue
                if frame.get("type") == "user":
                    content = (frame.get("message") or {}).get("content") or ""
                    # strip envelope if present
                    m = re.search(
                        rf"<{TAG}[^>]*>\n([\s\S]*?)\n</{TAG}>", content
                    )
                    body = m.group(1) if m else content
                    return body
            buf = b""
    finally:
        srv.close()
        if GROK_SOCK.exists():
            GROK_SOCK.unlink()
    return None


def cmd_ask(args: argparse.Namespace) -> int:
    peers = enrich(load_peers(), tmux_panes())
    peer = resolve(args.target, peers)
    if peer.get("status") not in ("idle", "unknown") and not args.force:
        print(
            f"peer {peer['name']} status={peer['status']}; pass --force to inject anyway",
            file=sys.stderr,
        )
        return 2
    msg = " ".join(args.message)
    marker = f"GROK_PI_ASK_{uuid.uuid4().hex[:8]}"
    # Tag the prompt so capture can find it if relay fails
    tagged = f"{msg}\n\n(When done, include this token once in your reply: {marker})"
    # Start listener before inject
    import threading

    box: dict = {"reply": None}

    def worker():
        box["reply"] = listen_ask_reply(args.timeout)

    t = threading.Thread(target=worker, daemon=True)
    t.start()
    time.sleep(0.15)
    mid = inject(peer, tagged, ask=True)
    print(f"asked {mid} -> {peer['name']} (pid {peer['pid']}) tmux={peer.get('tmux')}", file=sys.stderr)
    t.join(timeout=args.timeout + 1)
    if box["reply"]:
        print(box["reply"])
        return 0
    # Fallback: capture-pane
    print("(no socket relay; falling back to tmux capture)", file=sys.stderr)
    print(wait_reply_via_capture(peer, marker, args.timeout))
    return 0


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__)
    sub = ap.add_subparsers(dest="cmd", required=True)

    p = sub.add_parser("list", help="List live Pi peers")
    p.set_defaults(func=cmd_list)

    p = sub.add_parser("capture", help="Capture a tmux pane")
    p.add_argument("target", help="tmux target e.g. code:8.0")
    p.add_argument("--lines", type=int, default=120)
    p.set_defaults(func=cmd_capture)

    p = sub.add_parser("send", help="Fire-and-forget inject")
    p.add_argument("target")
    p.add_argument("message", nargs="+")
    p.add_argument("--force", action="store_true")
    p.set_defaults(func=cmd_send)

    p = sub.add_parser("ask", help="Inject and wait for reply")
    p.add_argument("target")
    p.add_argument("message", nargs="+")
    p.add_argument("--force", action="store_true")
    p.add_argument("--timeout", type=float, default=120.0)
    p.set_defaults(func=cmd_ask)

    args = ap.parse_args()
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())
