#!/bin/sh

# Launch pi from the bundled entrypoint when there is a current one.
#
# The node install's `pi` bin symlink points here instead of at dist/cli.js.
# See bin/pi-bundle, which builds the bundle and repoints that symlink.
#
# POSIX sh with no external commands on the happy path: this runs on every pi
# launch and the whole point of the exercise is milliseconds.

dir=${0%/*}
[ "$dir" = "$0" ] && dir=.
node="$dir/node"
[ -x "$node" ] || node=node

# V8 caches the compiled form of every module it loads under here, worth ~80ms
# (13%) off every launch. Compiling the bundle is the single biggest thing pi
# does before main() -- 8.7MB in one file, ~320ms of parse and compile against
# 30ms for node itself and 307ms for all of main() -- and none of that work
# changes between launches.
#
# Node namespaces the directory by version, arch and build id, and keys entries
# by source hash, so an upgrade is a cache miss rather than stale code. Honour
# an existing value; PI_NO_COMPILE_CACHE=1 opts out.
if [ -z "${NODE_COMPILE_CACHE:-}" ] && [ -z "${PI_NO_COMPILE_CACHE:-}" ]; then
  NODE_COMPILE_CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/pi/v8"
  export NODE_COMPILE_CACHE
fi

# Inside tmux, pi resolves hyperlink support with a blocking execSync during
# boot (`tmux display-message -p '#{client_termfeatures}'` from node: ~10ms
# warm, up to the 250ms timeout when the server is busy, and the first exec of
# the day also pays a page-cache miss — 162ms measured). The answer only
# changes when the outer terminal does, so read the last answer from a cache
# instead of making node wait for it, and let a detached job refresh the cache
# off the boot path. pi's own probe stays as the fallback whenever the cache
# is unreadable, so the worst case is today's behavior. An explicit
# PI_HYPERLINKS in the environment wins; PI_NO_HYPERLINKS_REFRESH=1 opts out
# of the refresh job entirely.
if [ -n "${TMUX:-}" ] && [ -z "${PI_HYPERLINKS:-}" ] && [ -z "${PI_NO_HYPERLINKS_REFRESH:-}" ]; then
  hyperlinks_cache=${XDG_CACHE_HOME:-$HOME/.cache}/pi/tmux-hyperlinks
  # 2>/dev/null must precede the failing redirect, or the shell prints its own
  # complaint about the missing file before read even runs.
  read -r pi_hyperlinks 2>/dev/null < "$hyperlinks_cache" || true
  case ${pi_hyperlinks:-} in
    1|0) export PI_HYPERLINKS=$pi_hyperlinks ;;
  esac
  /bin/sh -c '
    cache=$1 cache_dir=${1%/*}
    mkdir -p "$cache_dir" 2>/dev/null || exit 0
    features=$(tmux display-message -p "#{client_termfeatures}" 2>/dev/null) || exit 0
    case ,${features}, in *,hyperlinks,*) printf 1 ;; *) printf 0 ;; esac > "$cache.tmp" \
      && mv "$cache.tmp" "$cache" || rm -f "$cache.tmp"
  ' sh "$hyperlinks_cache" >/dev/null 2>&1 &
fi

# Three managed paths in a bootstrapped profile are always symlinks into the
# dotfiles repo. A regular file there means something wrote *over* the link
# rather than through it -- a `jq ... > tmp && mv tmp settings.json` is the
# usual way -- and the edit reads as applied until the next bootstrap renames
# the file to .bak and relinks, at which point it is silently gone. Say so at
# the only moment anyone is looking. Three test builtins, no subprocess, and
# only for the two profiles this repo manages.
agent_dir=${PI_CODING_AGENT_DIR:-$HOME/.pi/agent}
case $agent_dir in
  "$HOME/.pi/agent")
    for managed in settings.json keybindings.json extensions; do
      if [ -e "$agent_dir/$managed" ] && [ ! -L "$agent_dir/$managed" ]; then
        echo "pi: $agent_dir/$managed is a regular file where a link into dotfiles belongs; run dotfiles-link-check" >&2
      fi
    done
    ;;
esac

# Two install layouts: npm's global prefix (bin/pi next to bin/node, package
# under ../lib/node_modules) and a plain node_modules tree (bin/pi in
# node_modules/.bin, package one level up), which is what mise's npm backend
# produces. Both are relative to the directory holding this launcher.
for rel in ../lib/node_modules/@earendil-works/pi-coding-agent ../@earendil-works/pi-coding-agent; do
  [ -d "$dir/$rel" ] && { pkg="$dir/$rel"; break; }
done
if [ -z "${pkg:-}" ]; then
  # Invoked from somewhere other than the install's bin directory.
  node=$(command -v node) || exit 127
  pkg="${node%/*}/../lib/node_modules/@earendil-works/pi-coding-agent"
fi

# npm rewrites package.json when it installs, so a bundle older than it was
# built from the previous version. Fall back rather than run stale code.
bundle="$pkg/dist/bundle.mjs"
if [ -z "${PI_NO_BUNDLE:-}" ] && [ -f "$bundle" ] && [ ! "$pkg/package.json" -nt "$bundle" ]; then
  exec "$node" "$bundle" "$@"
fi

exec "$node" "$pkg/dist/cli.js" "$@"
