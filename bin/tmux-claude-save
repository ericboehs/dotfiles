#!/usr/bin/env bash
# tmux-claude-save - Save tmux session state including Claude session IDs
#
# Captures every pane running Claude in a tmux session, resolves each pane's
# Claude session ID, and writes state to JSON for tmux-claude-restore.
#
# Session IDs come from ~/.claude/sessions/<pid>.json, which Claude Code
# maintains for each running instance. That file is an authoritative
# pid -> sessionId map, so no guessing from file timestamps is needed.
# Heuristics remain only as fallbacks for older Claude versions.
#
# Usage: tmux-claude-save [SESSION_NAME]
#   SESSION_NAME defaults to "future"

set -euo pipefail

SESSION_NAME="${1:-future}"
SAVE_DIR="$HOME/.config/tmux-claude"
SAVE_FILE="$SAVE_DIR/$SESSION_NAME.json"
CLAUDE_SESSIONS="$HOME/.claude/sessions"
PROJECTS_DIR="$HOME/.claude/projects"

for dep in tmux jq; do
  command -v "$dep" >/dev/null || { echo "Error: '$dep' is required" >&2; exit 1; }
done

mkdir -p "$SAVE_DIR"

if ! tmux has-session -t "$SESSION_NAME" 2>/dev/null; then
  echo "Error: tmux session '$SESSION_NAME' not found" >&2
  echo "Available sessions:" >&2
  tmux list-sessions -F '  #{session_name}' 2>/dev/null >&2 || true
  exit 1
fi

# Encode a cwd the way Claude names its project dirs: every character that is
# not alphanumeric or '-' becomes '-' (this includes '/', '.', '_', ' ' and '~').
cwd_to_project_dir() {
  printf '%s/%s\n' "$PROJECTS_DIR" "$(printf '%s' "$1" | sed 's/[^a-zA-Z0-9-]/-/g')"
}

# Walk a process tree (depth-limited) and echo every descendant pid.
descendants() {
  local pid="$1" depth="${2:-0}" child
  [ "$depth" -ge 4 ] && return 0
  for child in $(pgrep -P "$pid" 2>/dev/null || true); do
    printf '%s\n' "$child"
    descendants "$child" $((depth + 1))
  done
  return 0
}

# Echo the pid of the Claude process running in a pane, if any.
claude_pid_for_pane() {
  local pane_pid="$1" pid cmd
  for pid in $(descendants "$pane_pid"); do
    # A live sessions file is the strongest signal that this really is Claude.
    if [ -f "$CLAUDE_SESSIONS/$pid.json" ]; then
      printf '%s\n' "$pid"
      return 0
    fi
    cmd=$(ps -ww -o comm= -p "$pid" 2>/dev/null || true)
    if [ "$(basename "${cmd:-}")" = "claude" ]; then
      printf '%s\n' "$pid"
      return 0
    fi
  done
  return 0
}

# Fallback: pull a session id out of an explicit --resume argument.
session_id_from_args() {
  local uuid='[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}'
  printf '%s' "$1" | grep -oE -- "--resume[= ]$uuid" | grep -oE "$uuid" | head -1 || true
  return 0
}

# Fallback: most recently modified transcript in the project dir that has not
# already been claimed by another pane. Dedup matters because several panes
# frequently share one cwd.
session_id_from_recent() {
  local project_dir="$1" f id
  [ -d "$project_dir" ] || return 0
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    id=$(basename "$f" .jsonl)
    case " $CLAIMED " in
      *" $id "*) continue ;;
    esac
    printf '%s\n' "$id"
    return 0
  done < <(ls -t "$project_dir"/*.jsonl 2>/dev/null)
  return 0
}

echo "Scanning tmux session: $SESSION_NAME"
echo ""

CLAIMED=""
entries="[]"
total=0
found=0

while IFS='|' read -r window_index pane_index pane_pid window_name; do
  claude_pid=$(claude_pid_for_pane "$pane_pid")
  [ -n "$claude_pid" ] || continue

  total=$((total + 1))
  session_id=""
  detection_method=""
  session_name=""
  cwd=""
  state_file="$CLAUDE_SESSIONS/$claude_pid.json"

  # Method 1 (authoritative): Claude's own per-pid session state.
  if [ -f "$state_file" ]; then
    session_id=$(jq -r '.sessionId // empty' "$state_file" 2>/dev/null || true)
    cwd=$(jq -r '.cwd // empty' "$state_file" 2>/dev/null || true)
    session_name=$(jq -r '.name // empty' "$state_file" 2>/dev/null || true)
    [ -n "$session_id" ] && detection_method="claude_state"
  fi

  claude_cmd=$(ps -ww -o args= -p "$claude_pid" 2>/dev/null || true)

  # Resolve cwd from the process if Claude's state file did not supply one.
  if [ -z "$cwd" ]; then
    cwd=$(lsof -p "$claude_pid" -a -d cwd -Fn 2>/dev/null | grep '^n' | sed 's/^n//' | head -1 || true)
  fi

  # Method 2: an explicit --resume on the command line.
  if [ -z "$session_id" ]; then
    session_id=$(session_id_from_args "$claude_cmd")
    [ -n "$session_id" ] && detection_method="command_args"
  fi

  # Method 3: most recent unclaimed transcript for this cwd.
  if [ -z "$session_id" ] && [ -n "$cwd" ]; then
    session_id=$(session_id_from_recent "$(cwd_to_project_dir "$cwd")")
    [ -n "$session_id" ] && detection_method="most_recent_fallback"
  fi

  [ -n "$session_id" ] && CLAIMED="$CLAIMED $session_id"

  has_skip_permissions=false
  case "$claude_cmd" in
    *--dangerously-skip-permissions*) has_skip_permissions=true ;;
  esac

  if [ -n "$session_id" ]; then
    status_icon="✓"
    found=$((found + 1))
  else
    status_icon="✗"
    detection_method="none"
  fi

  echo "  $status_icon Window $window_index ($window_name) → ${session_id:-(unknown)} ($detection_method)"
  echo "    cwd: ${cwd:-(unknown)}${session_name:+  name: $session_name}"

  entries=$(jq -c \
    --argjson window_index "$window_index" \
    --argjson pane_index "$pane_index" \
    --arg window_name "$window_name" \
    --arg cwd "$cwd" \
    --arg session_id "$session_id" \
    --arg session_name "$session_name" \
    --arg detection_method "$detection_method" \
    --argjson skip_perms "$has_skip_permissions" \
    --argjson claude_pid "$claude_pid" \
    '. + [{
       window_index: $window_index,
       window_name: $window_name,
       pane_index: $pane_index,
       cwd: $cwd,
       session_id: $session_id,
       session_name: $session_name,
       detection_method: $detection_method,
       dangerously_skip_permissions: $skip_perms,
       claude_pid: $claude_pid
     }]' <<<"$entries")
done < <(tmux list-panes -t "$SESSION_NAME" -s -F '#{window_index}|#{pane_index}|#{pane_pid}|#{window_name}')

if [ "$total" -eq 0 ]; then
  echo "  (no panes running Claude found)"
  echo ""
  echo "Nothing to save; leaving any existing $SAVE_FILE untouched." >&2
  exit 1
fi

tmp=$(mktemp)
trap 'rm -f "$tmp"' EXIT
jq -n \
  --arg session_name "$SESSION_NAME" \
  --arg saved_at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
  --argjson windows "$entries" \
  '{session_name: $session_name, saved_at: $saved_at, windows: $windows}' >"$tmp"
mv "$tmp" "$SAVE_FILE"

echo ""
echo "Saved to: $SAVE_FILE"
echo "Windows with Claude sessions: $found/$total"
