#!/usr/bin/env bash
# heavy: run a heavy command (xcodebuild, a test suite, bin/check) without swamping the Mac.
#
#   heavy xcodebuild -project ios/Botsun.xcodeproj ...
#   HEAVY_SLOTS=1 heavy bin/check --ios
#
# Three brakes:
#  1. Slots: at most HEAVY_SLOTS (default 1) heavy commands at once, across every shell and agent.
#     A command waits for a free slot. Locks are lockf(1) files in ~/Library/Caches/heavy, and a
#     slot frees itself when its command exits or dies.
#  2. CPU gate: it doesn't start while the CPU is less than HEAVY_MIN_IDLE percent idle (default
#     25, sampled over a second). Not the load average: a booting simulator and utility-clamped
#     builds put hundreds of threads in the run queue while the CPU is a third idle (load 900+ on
#     2026-11-10 with nothing wrong), so a load gate held work back for no reason.
#  3. Priority: it runs under `taskpolicy -c utility` (efficiency cores first, below interactive
#     work) and `nice -n 10`.
#
# Exit status is the command's own. If the command itself exits 75 (EX_TEMPFAIL, the code lockf
# uses for a busy lock), heavy treats the slot as busy and retries; that's an accepted rare
# ambiguity.
set -uo pipefail

[ $# -gt 0 ] || { echo "usage: heavy <command> [args...]" >&2; exit 64; }

# Already inside a heavy command (bin/check under heavy runs its own xcodebuilds through heavy):
# the slot is held, so run at once. Waiting would deadlock on our own slot.
[ "${HEAVY_HELD:-}" = 1 ] && exec "$@"
export HEAVY_HELD=1

slots=${HEAVY_SLOTS:-1}
min_idle=${HEAVY_MIN_IDLE:-25}
dir="$HOME/Library/Caches/heavy"
mkdir -p "$dir"

# Percent idle over the last second (top's second sample; the first is since boot).
idle() { top -l 2 -n 0 -s 1 2>/dev/null | awk '/CPU usage/ { v = $7 } END { sub("%", "", v); print int(v) }'; }

waited=0
while :; do
  if [ "$(idle)" -ge "$min_idle" ]; then
    for n in $(seq 1 "$slots"); do
      lockf -s -t 0 "$dir/slot-$n" taskpolicy -c utility nice -n 10 "$@"
      status=$?
      [ "$status" -ne 75 ] && exit "$status"
    done
  fi
  if [ $((waited % 60)) -eq 0 ]; then
    echo "heavy: waiting for a slot (CPU $(idle)% idle, needs $min_idle%; $slots slot(s)): $1" >&2
  fi
  sleep 10
  waited=$((waited + 10))
done
