#!/usr/bin/env bash
# heavy: run a heavy command (xcodebuild, a test suite, bin/check) without swamping the Mac.
#
#   heavy xcodebuild -project ios/Botsun.xcodeproj ...
#   HEAVY_SLOTS=1 heavy bin/check --ios   # one at a time, e.g. while you work
#
# Four brakes:
#  1. Slots: at most HEAVY_SLOTS (default 2) heavy commands at once, across every shell and agent.
#     A command waits for a free slot. Locks are lockf(1) files in ~/Library/Caches/heavy, and a
#     slot frees itself when its command exits or dies. Two slots (2026-11-20): one let five agents
#     queue for hours while the CPU sat mostly idle. The iPad UI lanes stay one at a time through
#     bin/check's own lock (~/Library/Caches/botsun/ipad-checks.lock).
#  2. CPU gate: it doesn't start while the CPU is less than HEAVY_MIN_IDLE percent idle (default
#     25, sampled over a second). Not the load average: a booting simulator and utility-clamped
#     builds put hundreds of threads in the run queue while the CPU is a third idle (load 900+ on
#     2026-11-10 with nothing wrong), so a load gate held work back for no reason.
#  3. Simulators: it doesn't start while more than HEAVY_MAX_SIMS (default 4) simulators are
#     booted. Each stock simulator is ~180 daemons and ~4 GB (2026-11-19: six booted pushed the
#     load to 190); agents leave them running. HEAVY_MAX_SIMS=0 turns the brake off.
#  4. Priority: it runs under `taskpolicy -c utility` (efficiency cores first, below interactive
#     work) and `nice -n 10`.
#
# Exit status is the command's own. If the command itself exits 75 (EX_TEMPFAIL, the code lockf
# uses for a busy lock), heavy treats the slot as busy and retries; that's an accepted rare
# ambiguity.
set -uo pipefail

[ $# -gt 0 ] || { echo "usage: heavy <command> [args...]" >&2; exit 64; }

# Already inside a heavy command (bin/check under heavy runs its own xcodebuilds through heavy):
# the slot is held, so run at once. Waiting would deadlock on our own slot.
[ "${HEAVY_HELD:-}" = 1 ] && exec "$@"
export HEAVY_HELD=1

case "${HEAVY_SLOTS:-}" in "") ;; *[!0-9]*) echo "heavy: HEAVY_SLOTS must be a number: $HEAVY_SLOTS" >&2; exit 64 ;; esac
case "${HEAVY_MIN_IDLE:-}" in "") ;; *[!0-9]*) echo "heavy: HEAVY_MIN_IDLE must be a number: $HEAVY_MIN_IDLE" >&2; exit 64 ;; esac

slots=${HEAVY_SLOTS:-2}
min_idle=${HEAVY_MIN_IDLE:-25}
max_sims=${HEAVY_MAX_SIMS:-4}
dir="$HOME/Library/Caches/heavy"
mkdir -p "$dir"

# Booted simulators (0 when there's no simctl).
sims() { xcrun simctl list devices booted 2>/dev/null | grep -c '(Booted)'; }
sims_ok() { [ "$max_sims" -eq 0 ] || [ "$(sims)" -le "$max_sims" ]; }

# Percent idle over the last second (top's second sample; the first is since boot).
idle() { top -l 2 -n 0 -s 1 2>/dev/null | awk '/CPU usage/ { v = $7 } END { sub("%", "", v); print int(v) }'; }

# A temporary override, re-read on every pass so waiting commands pick it up: the file
# ~/Library/Caches/heavy/slots holds "SLOTS UNTIL-EPOCH [MIN-IDLE]" (e.g. "3 1795420800 10");
# past UNTIL it's ignored. HEAVY_SLOTS / HEAVY_MIN_IDLE set in the environment still win.
override_msg=""
override_slots() {
  override_msg=""
  local n until idle_min now
  read -r n until idle_min < "$dir/slots" 2>/dev/null || [ -n "${n:-}" ] || return
  case "$n$until${idle_min:-0}" in *[!0-9]*|"") return ;; esac
  [ -n "$until" ] && [ "$n" -ge 1 ] || return
  now=$(date +%s)
  [ "$now" -lt "$until" ] || return
  [ "$until" -le $((now + 7 * 24 * 3600)) ] || return
  [ -z "${HEAVY_SLOTS:-}" ] && slots=$n
  [ -z "${HEAVY_MIN_IDLE:-}" ] && [ -n "${idle_min:-}" ] && min_idle=$idle_min
  override_msg=" (override until $(date -r "$until"))"
  return 0
}

waited=0
while :; do
  slots=${HEAVY_SLOTS:-2}
  min_idle=${HEAVY_MIN_IDLE:-25}
  override_slots
  [ "$slots" -ge 1 ] || slots=1
  cur_idle=$(idle)
  if sims_ok && [ "$cur_idle" -ge "$min_idle" ]; then
    for n in $(seq 1 "$slots"); do
      lockf -s -t 0 "$dir/slot-$n" taskpolicy -c utility nice -n 10 "$@"
      status=$?
      [ "$status" -ne 75 ] && exit "$status"
    done
  fi
  if [ $((waited % 60)) -eq 0 ]; then
    if sims_ok; then
      echo "heavy: waiting for a slot (CPU $cur_idle% idle, needs $min_idle%; $slots slot(s)$override_msg): $1" >&2
    else
      echo "heavy: waiting: $(sims) simulators booted, max $max_sims (xcrun simctl list devices booted): $1" >&2
    fi
  fi
  sleep 10
  waited=$((waited + 10))
done
