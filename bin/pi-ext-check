#!/usr/bin/env bash

# Typecheck and test the pi extensions in .pi-agent/extensions.
# Usage: pi-ext-check [-h|--help] [--typecheck-only|--test-only]
#
# Three checks, because tsc alone is not enough: it resolves imports against the
# working tree, so a tracked extension importing an untracked or gitignored
# helper typechecks green and then aborts pi's entire launch on any host that
# clones it. bin/pi-ext-imports is the guard for that class.
#
# pi loads these extensions from the globally installed @earendil-works/pi-coding-agent,
# so this borrows that install's types rather than pinning any dependency
# versions here: .pi-agent/package.json exists only to mark the directory ESM
# for tsc and Node, and .pi-agent/node_modules/ gets symlinks to the global pi,
# pi-tui, typebox and @types/node, which is enough for both tsc and Node's ESM
# resolver.

set -euo pipefail

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  echo "Usage: $(basename "$0") [--typecheck-only|--test-only]"
  echo ""
  echo "Check imports (pi-ext-imports), typecheck (tsc) and smoke-test (node --test)"
  echo "the pi extensions. Links .pi-agent/node_modules to the globally installed pi"
  echo "first. --typecheck-only runs the import guard too; both are static checks."
  exit 0
fi

MODE="${1:-all}"

# bin/ is symlinked to ~/bin, so resolve the real script location.
target="${BASH_SOURCE[0]}"
while [ -L "$target" ]; do
  link="$(readlink "$target")"
  case "$link" in
    /*) target="$link" ;;
    *) target="$(dirname "$target")/$link" ;;
  esac
done
# -P, not a plain cd: invoked as ~/bin/pi-ext-check the script itself is not a
# symlink (the *directory* is), so the loop above leaves it alone and bash's
# logical cd strips the `..` textually -- landing in $HOME instead of the repo.
# -P resolves ~/bin to bin/ before processing `..`.
REPO="$(cd -P "$(dirname "$target")/.." && pwd)"
PI_AGENT="$REPO/.pi-agent"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

# Both checks below treat "nothing to check" as success -- tsc is happy with an
# empty project and `node --test` reports 0 tests and exits 0 -- so a $PI_AGENT
# pointing somewhere wrong printed two green checks for having done nothing.
# Refuse to run at all rather than pass vacuously.
if [ ! -d "$PI_AGENT/extensions" ]; then
  echo -e "${RED}❌ no extensions at $PI_AGENT/extensions${NC}" >&2
  exit 1
fi

if ! command -v npm >/dev/null; then
  echo -e "${RED}❌ npm is not on PATH${NC}" >&2
  exit 1
fi

PI_PKG="$(npm root -g)/@earendil-works/pi-coding-agent"
if [ ! -d "$PI_PKG" ]; then
  echo -e "${RED}❌ pi is not installed globally at $PI_PKG${NC}" >&2
  exit 1
fi

# Extension-local dependencies are runtime state and stay gitignored. Restore
# them from each tracked lockfile before checking so a fresh clone behaves like
# this machine, including dev-only declaration packages needed by tsc.
for manifest in "$PI_AGENT"/extensions/*/package.json; do
  [ -f "$manifest" ] || continue
  package_dir="${manifest%/package.json}"
  echo "Installing check dependencies in $package_dir..."
  npm install --prefix "$package_dir" --include=dev --legacy-peer-deps \
    --ignore-scripts --no-audit --no-fund
done

# Fresh links every run: the global pi moves with each node version bump, and a
# stale symlink fails in ways that read like a broken extension.
mkdir -p "$PI_AGENT/node_modules/@earendil-works" "$PI_AGENT/node_modules/@types"
ln -sfn "$PI_PKG" "$PI_AGENT/node_modules/@earendil-works/pi-coding-agent"
ln -sfn "$PI_PKG/node_modules/@earendil-works/pi-tui" "$PI_AGENT/node_modules/@earendil-works/pi-tui"
ln -sfn "$PI_PKG/node_modules/@types/node" "$PI_AGENT/node_modules/@types/node"
# Extensions that register tools declare their schemas with typebox, which pi
# re-exports at runtime but tsc has to resolve on disk like any other import.
ln -sfn "$PI_PKG/node_modules/typebox" "$PI_AGENT/node_modules/typebox"

status=0

if [[ "$MODE" != "--test-only" ]]; then
  echo "Checking imports in $PI_AGENT/extensions..."
  if ! "$REPO/bin/pi-ext-imports" "$PI_AGENT/extensions"; then
    status=1
  fi
fi

if [[ "$MODE" != "--test-only" ]]; then
  # No typescript is installed anywhere on this machine by design, so fall back
  # to npx (cached after the first run) rather than adding a dependency.
  if command -v tsc >/dev/null; then
    TSC=(tsc)
  else
    echo -e "${YELLOW}tsc not on PATH — using npx typescript${NC}"
    TSC=(npx --yes --package=typescript@5 tsc)
  fi

  # Buffered so the TS1294 hint below can inspect the output; tsc says little
  # enough that nothing is lost by printing it in one go.
  tsc_log="$(mktemp -t pi-ext-check)"
  trap 'rm -f "$tsc_log"' EXIT

  echo "Typechecking $PI_AGENT/extensions..."
  if (cd "$PI_AGENT" && "${TSC[@]}" -p tsconfig.json) >"$tsc_log" 2>&1; then
    cat "$tsc_log"
    echo -e "${GREEN}✅ typecheck passed${NC}"
  else
    cat "$tsc_log"
    echo -e "${RED}❌ typecheck failed${NC}"
    # TS1294 reads like a style rule, so say what the flag is actually for
    # before someone "fixes" it by turning erasableSyntaxOnly off.
    if grep -q 'TS1294' "$tsc_log"; then
      echo -e "${YELLOW}   TS1294: erasableSyntaxOnly keeps these files importable by plain Node." >&2
      echo "   pi transpiles, so it tolerates parameter properties and enums, but" >&2
      echo "   bin/pi-scheduler imports extension .ts under Node's strip-only mode," >&2
      echo "   which rejects them outright (ERR_UNSUPPORTED_TYPESCRIPT_SYNTAX). Rewrite" >&2
      echo -e "   the construct; do not relax the flag.${NC}" >&2
    fi
    status=1
  fi
fi

if [[ "$MODE" != "--typecheck-only" ]]; then
  echo "Running $PI_AGENT/test..."
  tests=("$PI_AGENT"/test/*.test.mjs)
  if [ ! -e "${tests[0]}" ]; then
    echo -e "${RED}❌ no test files at $PI_AGENT/test${NC}" >&2
    status=1
  elif (cd "$PI_AGENT" && node --test test/*.test.mjs); then
    echo -e "${GREEN}✅ tests passed${NC}"
  else
    echo -e "${RED}❌ tests failed${NC}"
    status=1
  fi
fi

exit "$status"
