#!/bin/bash
# coop-worker NAME TASKFILE [options]: start a supervised pi worker on coop, from e14.
#
#   --repo REPO     repo under ~/Code/github.com/ericboehs on coop (default pi-boehsline)
#   --done FILE     file the task writes when finished (default REPORT-NAME.md)
#   --models "A B"  model chain (default in supervise.sh: xai grok-4.7, then opencode-go ds4.1f;
#                   also anthropic/claude-sonnet-5 or cursor on request)
#   --wait          block until it finishes and print the result (else: coop-worker --wait-only NAME)
#
# Syncs run.sh/supervise.sh (dotfiles bin/coop-workers) to coop's ~/coop-workers, copies the
# task to ~/coop-workers/NAME.md, makes worktree ~/worktrees/<pi|REPO>-NAME on branch NAME (reused if
# it exists; node_modules linked), and starts supervise.sh in tmux window code:NAME-sup.
set -euo pipefail
here=$(cd "$(dirname "$(readlink -f "$0")")" && pwd)/coop-workers
ssh_coop() { ssh -o ClearAllForwardings=yes -o ConnectTimeout=10 coop "$@"; }

if [ "${1:-}" = --wait-only ]; then exec "$here/wait.sh" "$2"; fi
[ $# -ge 2 ] || { sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//'; exit 2; }
name=$1 task=$2; shift 2
repo=pi-boehsline done_file= models= wait=
while [ $# -gt 0 ]; do
  case $1 in
    --repo) repo=$2; shift 2 ;;
    --done) done_file=$2; shift 2 ;;
    --models) models=$2; shift 2 ;;
    --wait) wait=1; shift ;;
    *) echo "coop-worker: unknown option $1" >&2; exit 2 ;;
  esac
done
[[ $name =~ ^[A-Za-z0-9._-]+$ ]] || { echo "coop-worker: NAME must be letters, digits, . _ -" >&2; exit 2; }
[[ $repo =~ ^[A-Za-z0-9._-]+$ ]] || { echo "coop-worker: bad --repo" >&2; exit 2; }
[ -f "$task" ] || { echo "coop-worker: no task file $task" >&2; exit 2; }
done_file=${done_file:-REPORT-$name.md}
short=$repo; [ "$repo" = pi-boehsline ] && short=pi
wt="worktrees/$short-$name"

if ssh_coop "tmux list-windows -t code -F '#W' | grep -qx '$name-sup'"; then
  echo "coop-worker: $name is already running (tmux code:$name-sup)" >&2; exit 1
fi

# Scripts: to a .new file, then mv, so a supervisor already running keeps reading its old copy.
ssh_coop 'mkdir -p ~/coop-workers'
for f in run.sh supervise.sh; do
  scp -q -o ClearAllForwardings=yes "$here/$f" "coop:coop-workers/$f.new"
done
scp -q -o ClearAllForwardings=yes "$task" "coop:coop-workers/$name.md"

ssh_coop bash -s -- "$name" "$repo" "$wt" "$done_file" "$models" <<'REMOTE'
set -euo pipefail
name=$1 repo=$2 wt=~/$3 done_file=$4 models=$5
cd ~/coop-workers
for f in run.sh supervise.sh; do mv "$f.new" "$f"; chmod +x "$f"; done
rm -f "$name.result"
src=~/Code/github.com/ericboehs/$repo
[ -d "$src/.git" ] || { echo "coop-worker: no repo $src on coop" >&2; exit 1; }
if [ ! -d "$wt" ]; then
  mkdir -p ~/worktrees
  if git -C "$src" show-ref -q --verify "refs/heads/$name"; then
    git -C "$src" worktree add -q "$wt" "$name"
  else
    git -C "$src" worktree add -q -b "$name" "$wt"
  fi
  [ -d "$src/node_modules" ] && [ ! -e "$wt/node_modules" ] && ln -s "$src/node_modules" "$wt/node_modules"
fi
env_models=; [ -n "$models" ] && env_models="MODELS=$(printf %q "$models") "
tmux new-window -d -t code: -n "$name-sup" \
  "${env_models}~/coop-workers/supervise.sh $name $wt $done_file"
sleep 3
tail -1 "$name.supervise"
REMOTE
echo "coop-worker: $name started in coop:$wt (done file $done_file)"
[ -n "$wait" ] && exec "$here/wait.sh" "$name"
echo "coop-worker: wait with: coop-worker --wait-only $name"
