#!/usr/bin/env bash
# pi-scheduler now ships as a pi package (github.com/ericboehs/pi-scheduler).
#
# ~/bin is a symlink to this directory, so this shim is what keeps the command
# on PATH across every host without each one needing a hand-made symlink into
# ~/.pi/agent/git. It execs the real CLI rather than wrapping it, so the file
# the process sees is the package's own: `pi-scheduler install` bakes an
# absolute path into the launchd job, and it must be the package path, not this.
set -euo pipefail

cli="${PI_AGENT_DIR:-$HOME/.pi/agent}/git/github.com/ericboehs/pi-scheduler/bin/pi-scheduler"

if [ ! -x "$cli" ]; then
  echo "pi-scheduler: package not installed at $cli" >&2
  echo "  pi install git:github.com/ericboehs/pi-scheduler" >&2
  exit 127
fi

exec "$cli" "$@"
