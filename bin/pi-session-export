#!/usr/bin/env ruby
# frozen_string_literal: true

# pi-session-export — render pi session JSONL transcripts to markdown for qmd.
#
# Pi stores sessions as JSONL under ~/.pi/agent/sessions/--<path>--/<ts>_<uuid>.jsonl
# (see pi docs/session-format.md). qmd's hybrid search works best on clean
# markdown, so this renders each session to ~/.pi/session-md/<project>/<file>.md
# containing just the conversation: user + assistant text. Tool results,
# thinking blocks, and base64 images are dropped.
#
# Incremental: a session is re-exported only when its source mtime is newer
# than the rendered file, so running this often is cheap.
#
# Called by ~/.local/bin/qmd-update-job (every 30 min) and spawned by the
# qmd-memory pi extension at session start/shutdown.
#
# Long sessions are split into parts of ~PART_BYTES, diagnosed 2026-10-22.
# qmd embeds per document hash with no chunk reuse, so rewriting one
# ever-growing file re-embedded all of it on every export: a 3.8MB session
# cost ~2,000 chunks each time it was touched, orphaning the previous ~2,000,
# and `qmd cleanup` was finding ~100k orphans two days after the last run.
# Parts are filled greedily from the first turn, and the JSONL is append-only,
# so once a part fills its bytes never change again; only the tail part is
# re-embedded. Part 1 keeps the historical filename so short sessions are
# untouched; later parts are <name>-partNN.md. Part headers deliberately omit
# a total ("part 3 of N"), which would rewrite every part as N grows.

require "json"
require "fileutils"

SESSIONS_DIR = ENV.fetch("PI_SESSIONS_DIR", File.expand_path("~/.pi/agent/sessions"))
OUT_DIR      = ENV.fetch("PI_SESSION_MD_DIR", File.expand_path("~/.pi/session-md"))
PART_BYTES   = Integer(ENV.fetch("PI_SESSION_MD_PART_BYTES", "150000"))

exported = 0
skipped  = 0
failed   = 0

def text_of(content)
  if content.is_a?(String)
    content
  elsif content.is_a?(Array)
    content.filter_map { |c| c["text"] if c.is_a?(Hash) && c["type"] == "text" }.join("\n")
  end
end

def slugify(str, max = 60)
  s = str.to_s.downcase.gsub(/[^a-z0-9]+/, "-").gsub(/^-+|-+$/, "")
  s.empty? ? "session" : s[0, max].gsub(/-+$/, "")
end

sessions = Dir.glob(File.join(SESSIONS_DIR, "**", "*.jsonl")).sort
sessions.each do |src|
  begin
    project_dir = nil
    session_ts  = nil
    session_id  = File.basename(src, ".jsonl")
    name        = nil
    first_user  = nil
    turns       = []

    # Always read as UTF-8. Under launchd there is no LANG/LC_ALL, so Ruby's
    # Encoding.default_external falls back to US-ASCII and every session
    # containing a non-ASCII byte (box drawing, curly quotes, arrows) died with
    # Encoding::InvalidByteSequenceError. The per-file rescue swallowed it and
    # the script still exited 0, so the scheduled pass silently exported almost
    # nothing while manual runs from a UTF-8 shell looked fine.
    File.foreach(src, encoding: "UTF-8") do |line|
      begin
        entry = JSON.parse(line)
      rescue JSON::ParserError
        next
      end

      case entry["type"]
      when "session"
        project_dir = entry["cwd"]
        session_ts  = entry["timestamp"]
      when "session_info"
        name = entry["name"] if entry["name"].to_s != ""
      when "compaction"
        turns << ["Compaction Summary", entry["summary"].to_s] unless entry["summary"].to_s.empty?
      when "branch_summary"
        turns << ["Branch Summary", entry["summary"].to_s] unless entry["summary"].to_s.empty?
      when "message"
        msg  = entry["message"]
        next unless msg.is_a?(Hash)
        text = text_of(msg["content"])
        next if text.nil? || text.strip.empty?

        case msg["role"]
        when "user"
          first_user ||= text.strip.lines.first.to_s.strip
          turns << ["User", text]
        when "assistant"
          turns << ["Assistant", text]
        end
      end
    end

    next if turns.empty? # header-only / abandoned sessions

    project_key = project_dir.to_s.gsub("/", "-").gsub(/^-+/, "")
    project_key = "unknown" if project_key.empty?
    dest_dir  = File.join(OUT_DIR, project_key)
    uuid = session_id.include?("_") ? session_id.split("_").last : session_id
    dest_name = "#{(session_ts || "unknown-date")[0, 10]}-#{slugify(name || first_user)}-#{uuid[0, 8]}.md"
    dest      = File.join(dest_dir, dest_name)

    if File.exist?(dest) && File.mtime(src) <= File.mtime(dest)
      skipped += 1
      next
    end

    title = name || first_user || session_id
    header = lambda do |part|
      h = +"# #{title}#{" (part #{part})" if part > 1}\n\n"
      h << "- Session: #{session_id}\n"
      h << "- Date: #{session_ts}\n" if session_ts
      h << "- Project: #{project_dir}\n" if project_dir
      h << "\n---\n\n"
    end

    # Greedy fill from the start: a part closes when the next turn would push
    # it past PART_BYTES (a single oversized turn gets a part to itself).
    bodies = [header.call(1)]
    part_len = 0
    turns.each do |role, text|
      chunk = "## #{role}\n\n#{text.strip}\n\n"
      if part_len.positive? && part_len + chunk.bytesize > PART_BYTES
        bodies << header.call(bodies.size + 1)
        part_len = 0
      end
      bodies[-1] << chunk
      part_len += chunk.bytesize
    end

    base  = dest.delete_suffix(".md")
    paths = bodies.each_index.map { |i| i.zero? ? dest : format("%s-part%02d.md", base, i + 1) }

    FileUtils.mkdir_p(dest_dir)
    paths.zip(bodies).each do |path, body|
      # Leave full parts byte-for-byte alone; that is the whole point.
      next if File.exist?(path) && File.read(path, encoding: "UTF-8") == body

      tmp = "#{path}.tmp-#{Process.pid}"
      File.write(tmp, body)
      File.rename(tmp, path)
    end
    # Part 1 may be unchanged; its mtime is still the up-to-date marker.
    FileUtils.touch(dest)

    # Parts left over from a rename (slug change) or an older layout. uuid[0,8]
    # of a v7 UUID is a timestamp, so a sibling session started within the
    # same minute can share it: delete only files that name this session.
    Dir.glob(File.join(dest_dir, "*-#{uuid[0, 8]}{,-part[0-9][0-9]}.md")).each do |old|
      next if paths.include?(old)
      next unless File.foreach(old, encoding: "UTF-8").first(6).include?("- Session: #{session_id}\n")

      File.delete(old)
    end
    exported += 1
  rescue StandardError => e
    warn "pi-session-export: #{src}: #{e.class}: #{e.message}"
    failed += 1
  end
end

puts "pi-session-export: #{exported} exported, #{skipped} skipped, #{failed} failed (#{sessions.size} scanned)"