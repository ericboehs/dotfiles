#!/usr/bin/env python3
"""Grok Bot peer daemon for Claude / pi-agent-link cross-session mesh.

Registers as name "grok-bot" in ~/.claude/sessions so Pi and Claude can see
and message it. Runs on e14 (Unix sockets cannot live in Grok's Linux VM).

Commands:
  start              Foreground: bind sock, register, serve forever
  start --background Background via nohup + pidfile
  status             Print registered / live state
  stop               SIGTERM background (or matching) instance
  inbox [--n N]      Show recent inbound messages (default 20)
  pending            List unanswered asks
  reply <msg_id> <text...>
                     Send reply frame to the asker's socket

Inbound user frames land in ~/.local/share/grok-bot-peer/inbox.jsonl.
Asks are recorded under pending/<msg_id>.json; the sender blocks until
`reply` is run (or their ask timeout, typically ~120s). This daemon does
NOT invent Grok answers.

Optional webhook wake (preferred over polling):
  ~/.local/share/grok-bot-peer/webhook.env  (or webhook.json)
  GROK_BOT_WEBHOOK_URL=...
  GROK_BOT_WEBHOOK_KEY=...
On each inbound message, POSTs JSON to the Grok Bot routine "Pi peer inbound"
(pi-peer-inbound) so the cloud chat wakes. Fire-and-forget; never blocks the
socket accept loop.
"""
from __future__ import annotations

import argparse
import json
import os
import re
import signal
import socket
import subprocess
import sys
import threading
import time
import urllib.error
import urllib.request
import uuid
from datetime import datetime, timezone
from pathlib import Path

HOME = Path.home()
REGISTRY = HOME / ".claude" / "sessions"
DATA = HOME / ".local" / "share" / "grok-bot-peer"
INBOX = DATA / "inbox.jsonl"
PENDING_DIR = DATA / "pending"
PIDFILE = DATA / "daemon.pid"
STATEFILE = DATA / "state.json"
WEBHOOK_ENV = DATA / "webhook.env"
WEBHOOK_JSON = DATA / "webhook.json"
WEBHOOK_LOG = DATA / "webhook.log"
NAME = "grok-bot"
TAG = "cross-session-message"
MAX_LINE = 1024 * 1024
ASK_MODE = "ask"
REPLY_MODE = "reply"
WEBHOOK_TIMEOUT_S = 8.0


def cc_socks_dir() -> Path:
    if REGISTRY.is_dir():
        for f in REGISTRY.glob("*.json"):
            if not re.match(r"^\d+\.json$", f.name):
                continue
            try:
                d = json.loads(f.read_text())
            except Exception:
                continue
            sock = d.get("messagingSocketPath") or ""
            if isinstance(sock, str) and sock.endswith(".sock"):
                return Path(sock).parent
    base = os.environ.get("XDG_RUNTIME_DIR", "/tmp")
    return Path(base) / "cc-socks"


def ensure_dirs() -> None:
    DATA.mkdir(parents=True, exist_ok=True)
    PENDING_DIR.mkdir(parents=True, exist_ok=True)
    socks = cc_socks_dir()
    socks.mkdir(parents=True, exist_ok=True)
    try:
        os.chmod(socks, 0o700)
    except OSError:
        pass
    REGISTRY.mkdir(parents=True, exist_ok=True)


def sock_live(path: str, timeout: float = 0.25) -> bool:
    try:
        s = socket.socket(socket.AF_UNIX)
        s.settimeout(timeout)
        s.connect(path)
        s.close()
        return True
    except OSError:
        return False


def proc_start(pid: int) -> str | None:
    try:
        out = subprocess.check_output(
            ["ps", "-o", "lstart=", "-p", str(pid)], text=True
        ).strip()
        return out or None
    except Exception:
        return None


def pid_alive(pid: int) -> bool:
    try:
        os.kill(pid, 0)
        return True
    except OSError:
        return False


def write_json(path: Path, obj: dict) -> None:
    tmp = path.with_suffix(path.suffix + ".tmp")
    tmp.write_text(json.dumps(obj, indent=2) + "\n")
    tmp.replace(path)


def load_state() -> dict:
    if STATEFILE.exists():
        try:
            return json.loads(STATEFILE.read_text())
        except Exception:
            pass
    return {}


def save_state(patch: dict) -> None:
    cur = load_state()
    cur.update(patch)
    write_json(STATEFILE, cur)


def _parse_env_file(path: Path) -> dict[str, str]:
    out: dict[str, str] = {}
    for raw in path.read_text().splitlines():
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        if line.startswith("export "):
            line = line[7:].strip()
        if "=" not in line:
            continue
        k, v = line.split("=", 1)
        k = k.strip()
        v = v.strip().strip("'").strip('"')
        if k:
            out[k] = v
    return out


def load_webhook_config() -> dict | None:
    """Return {url, key} or None. Never logs the key value."""
    url = os.environ.get("GROK_BOT_WEBHOOK_URL", "").strip()
    key = os.environ.get("GROK_BOT_WEBHOOK_KEY", "").strip()
    if WEBHOOK_JSON.exists():
        try:
            d = json.loads(WEBHOOK_JSON.read_text())
            url = (d.get("GROK_BOT_WEBHOOK_URL") or d.get("url") or url or "").strip()
            key = (d.get("GROK_BOT_WEBHOOK_KEY") or d.get("key") or key or "").strip()
        except Exception as e:
            sys.stderr.write(f"webhook.json unreadable: {e}\n")
    if WEBHOOK_ENV.exists():
        try:
            env = _parse_env_file(WEBHOOK_ENV)
            url = (env.get("GROK_BOT_WEBHOOK_URL") or url or "").strip()
            key = (env.get("GROK_BOT_WEBHOOK_KEY") or key or "").strip()
        except Exception as e:
            sys.stderr.write(f"webhook.env unreadable: {e}\n")
    if not url or not key:
        return None
    return {"url": url, "key": key}


def webhook_log(msg: str) -> None:
    ensure_dirs()
    ts = datetime.now().astimezone().isoformat(timespec="seconds")
    line = f"{ts} {msg}\n"
    try:
        with WEBHOOK_LOG.open("a") as f:
            f.write(line)
    except OSError:
        pass
    sys.stderr.write(f"[webhook] {msg}\n")


def post_webhook(cfg: dict, payload: dict) -> None:
    """Synchronous POST; intended to run on a background thread."""
    body = json.dumps(payload).encode()
    # Docs: Authorization: Bearer <key>. Also send X-Automation-Key (make-bot-ui)
    # and X-Webhook-Key so Eric can confirm which header the gateway accepts.
    headers = {
        "Content-Type": "application/json",
        "Authorization": f"Bearer {cfg['key']}",
        "X-Automation-Key": cfg["key"],
        "X-Webhook-Key": cfg["key"],
        "User-Agent": "grok-bot-peer/1.0",
    }
    req = urllib.request.Request(cfg["url"], data=body, headers=headers, method="POST")
    try:
        with urllib.request.urlopen(req, timeout=WEBHOOK_TIMEOUT_S) as resp:
            code = getattr(resp, "status", None) or resp.getcode()
            webhook_log(f"ok status={code} msg_id={payload.get('msg_id')}")
    except urllib.error.HTTPError as e:
        webhook_log(f"fail HTTP {e.code} msg_id={payload.get('msg_id')}: {e.reason}")
    except Exception as e:
        webhook_log(f"fail msg_id={payload.get('msg_id')}: {type(e).__name__}: {e}")


def fire_webhook(cfg: dict | None, payload: dict, *, hinted: list[bool]) -> None:
    if not cfg:
        if not hinted[0]:
            hinted[0] = True
            webhook_log(
                "skip: webhook unset — create ~/.local/share/grok-bot-peer/webhook.env "
                "with GROK_BOT_WEBHOOK_URL and GROK_BOT_WEBHOOK_KEY (from routine "
                "Pi peer inbound / pi-peer-inbound panel), then restart"
            )
        return
    t = threading.Thread(target=post_webhook, args=(cfg, payload), daemon=True)
    t.start()


def strip_envelope(content: str) -> dict:
    if not isinstance(content, str):
        return {"body": ""}
    m = re.match(
        rf'^<{TAG}((?:\s+[a-z-]+="[^"]*")*)>\n([\s\S]*)\n</{TAG}>$',
        content,
    )
    if not m:
        return {"body": content}
    attrs: dict[str, str] = {}
    for a in re.finditer(r'([a-z-]+)="([^"]*)"', m.group(1)):
        attrs[a.group(1)] = a.group(2)
    body = re.sub(
        rf"<\\/(?={TAG}(?:[>\s/]|$))",
        "</",
        m.group(2),
        flags=re.IGNORECASE,
    )
    hops_raw = attrs.get("hops")
    hops = None
    if hops_raw is not None:
        try:
            n = int(hops_raw)
            if n >= 0:
                hops = n
        except ValueError:
            pass
    return {
        "body": body,
        "from": attrs.get("from"),
        "fromName": attrs.get("from-name"),
        "fromMode": attrs.get("from-mode"),
        "hops": hops,
    }


def build_envelope(
    body: str,
    *,
    from_addr: str | None = None,
    from_name: str | None = None,
    from_mode: str | None = None,
    hops: int | None = None,
) -> str:
    attrs: list[str] = []
    if from_addr:
        attrs.append(f'from="{from_addr}"')
    if from_name:
        safe = re.sub(r'["<>]', "", from_name)
        attrs.append(f'from-name="{safe}"')
    if from_mode:
        attrs.append(f'from-mode="{from_mode}"')
    if hops:
        attrs.append(f'hops="{int(hops)}"')
    esc = re.sub(
        rf"</(?={TAG}(?:[>\s/]|$))",
        "<\\/",
        body,
        flags=re.IGNORECASE,
    )
    a = (" " + " ".join(attrs)) if attrs else ""
    return f"<{TAG}{a}>\n{esc}\n</{TAG}>"


def build_user_frame(
    content: str, *, from_addr: str | None = None, priority: str = "next"
) -> dict:
    frame: dict = {
        "msgV": 1,
        "msg_id": str(uuid.uuid4()),
        "type": "user",
        "priority": priority,
        "message": {"role": "user", "content": content},
    }
    if from_addr:
        frame["from"] = from_addr
    return frame


def receipt_frame(
    *,
    status: str,
    from_addr: str | None = None,
    orig_msg_id: str | None = None,
    reason: str | None = None,
) -> dict:
    frame: dict = {
        "msgV": 1,
        "msg_id": str(uuid.uuid4()),
        "type": "control",
        "action": "peer_message_status",
        "status": status,
    }
    if reason:
        frame["reason"] = reason
    if from_addr:
        frame["from"] = from_addr
    if orig_msg_id:
        frame["orig_msg_id"] = orig_msg_id
    return frame


def send_frame(sock_path: str, frame: dict, timeout: float = 5.0) -> None:
    data = (json.dumps(frame) + "\n").encode()
    s = socket.socket(socket.AF_UNIX)
    s.settimeout(timeout)
    try:
        s.connect(sock_path)
        s.sendall(data)
    finally:
        s.close()


class PeerDaemon:
    def __init__(self) -> None:
        self.pid = os.getpid()
        self.socks_dir = cc_socks_dir()
        self.sock_path = self.socks_dir / f"{self.pid}.sock"
        self.own_from = f"uds:{self.sock_path}"
        self.session_id = str(uuid.uuid4())
        self.started_at = int(time.time() * 1000)
        self.status = "idle"
        self._server: socket.socket | None = None
        self._stop = threading.Event()
        self._lock = threading.Lock()
        self._pending_count = 0
        self._webhook = load_webhook_config()
        self._webhook_hinted = [False]

    def register(self) -> None:
        entry = {
            "pid": self.pid,
            "sessionId": self.session_id,
            "cwd": str(HOME),
            "startedAt": self.started_at,
            "procStart": proc_start(self.pid),
            "version": "grok-bot-peer",
            "peerProtocol": 1,
            "kind": "interactive",
            "entrypoint": "grok-bot",
            "messagingSocketPath": str(self.sock_path),
            "name": NAME,
            "nameSource": "user",
            "status": self.status,
        }
        write_json(REGISTRY / f"{self.pid}.json", entry)
        save_state(
            {
                "pid": self.pid,
                "sock": str(self.sock_path),
                "sessionId": self.session_id,
                "startedAt": self.started_at,
                "name": NAME,
                "webhook_configured": bool(self._webhook),
            }
        )
        PIDFILE.write_text(str(self.pid) + "\n")

    def update_status(self, status: str) -> None:
        if status == self.status:
            return
        self.status = status
        reg = REGISTRY / f"{self.pid}.json"
        if not reg.exists():
            return
        try:
            cur = json.loads(reg.read_text())
        except Exception:
            return
        cur["status"] = status
        write_json(reg, cur)

    def deregister(self) -> None:
        try:
            (REGISTRY / f"{self.pid}.json").unlink(missing_ok=True)
        except OSError:
            pass
        try:
            if self.sock_path.exists() or self.sock_path.is_socket():
                self.sock_path.unlink(missing_ok=True)
        except OSError:
            pass
        try:
            if PIDFILE.exists() and PIDFILE.read_text().strip() == str(self.pid):
                PIDFILE.unlink(missing_ok=True)
        except OSError:
            pass

    def append_inbox(self, record: dict) -> None:
        ensure_dirs()
        with self._lock:
            with INBOX.open("a") as f:
                f.write(json.dumps(record) + "\n")

    def save_pending(self, msg_id: str, record: dict) -> None:
        ensure_dirs()
        write_json(PENDING_DIR / f"{msg_id}.json", record)
        with self._lock:
            self._pending_count += 1
        self.update_status("thinking")

    def handle_user_frame(self, frame: dict) -> None:
        raw = (frame.get("message") or {}).get("content") or ""
        if not isinstance(raw, str) or not raw:
            return
        env = strip_envelope(raw)
        from_addr = frame.get("from") or env.get("from") or ""
        from_sock = (
            from_addr[4:]
            if isinstance(from_addr, str) and from_addr.startswith("uds:")
            else ""
        )
        msg_id = frame.get("msg_id") or str(uuid.uuid4())
        from_mode = env.get("fromMode")
        body = env.get("body") or ""
        now = datetime.now(timezone.utc).astimezone().isoformat(timespec="seconds")
        mode = "ask" if from_mode == ASK_MODE else "send"

        record = {
            "ts": now,
            "msg_id": msg_id,
            "from": from_addr,
            "from_name": env.get("fromName"),
            "from_mode": from_mode,
            "hops": env.get("hops"),
            "body": body,
            "raw_preview": raw[:200],
        }
        self.append_inbox(record)

        # Wake Grok Bot via routine webhook (non-blocking)
        fire_webhook(
            self._webhook,
            {
                "source": "grok-bot-peer",
                "msg_id": msg_id,
                "from": from_addr,
                "from_name": env.get("fromName"),
                "mode": mode,
                "body": body,
                "received_at": now,
            },
            hinted=self._webhook_hinted,
        )

        if from_sock:
            try:
                send_frame(
                    from_sock,
                    receipt_frame(
                        status="delivered",
                        from_addr=self.own_from,
                        orig_msg_id=msg_id,
                        reason="Queued by grok-bot peer on e14.",
                    ),
                )
            except OSError:
                pass

        if from_mode == ASK_MODE and from_sock:
            self.save_pending(
                msg_id,
                {
                    "msg_id": msg_id,
                    "from": from_addr,
                    "from_sock": from_sock,
                    "from_name": env.get("fromName"),
                    "hops": (env.get("hops") or 0) + 1,
                    "body": body,
                    "received_at": now,
                    "note": (
                        "Ask is pending. Sender blocks until: "
                        f"grok-bot-peer reply {msg_id} <text...> "
                        "(or their ask timeout, typically ~120s)."
                    ),
                },
            )

    def handle_frame(self, frame: dict) -> None:
        if not isinstance(frame, dict):
            return
        if frame.get("type") == "control" and frame.get("action") == "rename":
            return
        if frame.get("type") == "user":
            try:
                self.handle_user_frame(frame)
            except Exception as e:
                sys.stderr.write(f"handle_user_frame error: {e}\n")

    def _serve_conn(self, conn: socket.socket) -> None:
        conn.settimeout(30.0)
        buf = b""
        try:
            while True:
                try:
                    chunk = conn.recv(65536)
                except socket.timeout:
                    break
                if not chunk:
                    break
                buf += chunk
                if len(buf) > MAX_LINE:
                    break
                while b"\n" in buf:
                    line, buf = buf.split(b"\n", 1)
                    if not line.strip():
                        continue
                    try:
                        frame = json.loads(line)
                    except json.JSONDecodeError:
                        continue
                    self.handle_frame(frame)
        except OSError:
            pass
        finally:
            try:
                conn.shutdown(socket.SHUT_RDWR)
            except OSError:
                pass
            try:
                conn.close()
            except OSError:
                pass

    def bind(self) -> None:
        ensure_dirs()
        if self.sock_path.exists() or self.sock_path.is_socket():
            self.sock_path.unlink(missing_ok=True)
        srv = socket.socket(socket.AF_UNIX)
        srv.bind(str(self.sock_path))
        try:
            os.chmod(self.sock_path, 0o600)
        except OSError:
            pass
        srv.listen(32)
        srv.settimeout(1.0)
        self._server = srv

    def run(self) -> int:
        self.bind()
        self.register()
        wh = "configured" if self._webhook else "UNSET (inbox-only until webhook.env)"
        print(
            f"grok-bot-peer listening pid={self.pid} sock={self.sock_path} "
            f"name={NAME} webhook={wh}",
            flush=True,
        )
        if not self._webhook:
            webhook_log(
                "startup: webhook unset — messages still land in inbox.jsonl; "
                "paste URL+key into webhook.env and restart to wake Grok Bot"
            )

        def _stop_handler(signum, _frame):
            print(f"\ngrok-bot-peer caught signal {signum}; shutting down", flush=True)
            self._stop.set()

        signal.signal(signal.SIGTERM, _stop_handler)
        signal.signal(signal.SIGINT, _stop_handler)

        assert self._server is not None
        try:
            while not self._stop.is_set():
                try:
                    conn, _ = self._server.accept()
                except socket.timeout:
                    continue
                except OSError:
                    if self._stop.is_set():
                        break
                    raise
                t = threading.Thread(target=self._serve_conn, args=(conn,), daemon=True)
                t.start()
        finally:
            try:
                self._server.close()
            except OSError:
                pass
            self.deregister()
            print("grok-bot-peer stopped; registry cleared", flush=True)
        return 0


def find_running() -> dict | None:
    if PIDFILE.exists():
        try:
            pid = int(PIDFILE.read_text().strip())
        except Exception:
            pid = None
        if pid and pid_alive(pid):
            reg = REGISTRY / f"{pid}.json"
            sock = None
            if reg.exists():
                try:
                    sock = json.loads(reg.read_text()).get("messagingSocketPath")
                except Exception:
                    pass
            st = load_state()
            sock = sock or st.get("sock")
            if sock and sock_live(sock):
                return {"pid": pid, "sock": sock, "registry": str(reg)}
    if REGISTRY.is_dir():
        for f in REGISTRY.glob("*.json"):
            if not re.match(r"^\d+\.json$", f.name):
                continue
            try:
                d = json.loads(f.read_text())
            except Exception:
                continue
            if d.get("name") != NAME:
                continue
            sock = d.get("messagingSocketPath") or ""
            pid = d.get("pid")
            if sock and sock_live(sock):
                return {"pid": pid, "sock": sock, "registry": str(f)}
    return None


def cmd_start(args: argparse.Namespace) -> int:
    ensure_dirs()
    existing = find_running()
    if existing:
        print(
            f"already running pid={existing['pid']} sock={existing['sock']}",
            file=sys.stderr,
        )
        return 1
    if args.background:
        cmd = [sys.executable, str(Path(__file__).resolve()), "start"]
        log = DATA / "daemon.log"
        with log.open("a") as lf:
            lf.write(f"\n--- start {datetime.now().isoformat(timespec='seconds')} ---\n")
            proc = subprocess.Popen(
                cmd,
                stdout=lf,
                stderr=subprocess.STDOUT,
                stdin=subprocess.DEVNULL,
                start_new_session=True,
            )
        for _ in range(50):
            time.sleep(0.1)
            got = find_running()
            if got:
                wh = "yes" if load_webhook_config() else "no"
                print(
                    f"started background pid={got['pid']} sock={got['sock']} webhook={wh}"
                )
                return 0
        print(
            f"started pid={proc.pid} but registry not visible yet; check {log}",
            file=sys.stderr,
        )
        return 0
    return PeerDaemon().run()


def cmd_status(_: argparse.Namespace) -> int:
    ensure_dirs()
    got = find_running()
    wh = load_webhook_config()
    wh_s = "configured" if wh else "unset"
    if not got:
        st = load_state()
        if st.get("pid"):
            print(
                f"not running (last pid={st.get('pid')} sock={st.get('sock')} — dead) "
                f"webhook={wh_s}"
            )
        else:
            print(f"not running webhook={wh_s}")
        return 1
    status = "?"
    name = NAME
    reg_path = Path(got["registry"]) if got.get("registry") else None
    if reg_path and reg_path.exists():
        try:
            d = json.loads(reg_path.read_text())
            status = d.get("status", "?")
            name = d.get("name", NAME)
        except Exception:
            pass
    pending = sorted(PENDING_DIR.glob("*.json")) if PENDING_DIR.is_dir() else []
    print(
        f"running name={name} pid={got['pid']} status={status} "
        f"sock={got['sock']} pending_asks={len(pending)} webhook={wh_s}"
    )
    return 0


def cmd_stop(_: argparse.Namespace) -> int:
    got = find_running()
    if not got:
        if PIDFILE.exists():
            try:
                pid = int(PIDFILE.read_text().strip())
            except Exception:
                pid = None
            if pid:
                reg = REGISTRY / f"{pid}.json"
                if reg.exists():
                    try:
                        d = json.loads(reg.read_text())
                        if d.get("name") == NAME:
                            reg.unlink(missing_ok=True)
                            sock = d.get("messagingSocketPath")
                            if sock:
                                Path(sock).unlink(missing_ok=True)
                    except Exception:
                        pass
            PIDFILE.unlink(missing_ok=True)
        print("not running")
        return 1
    pid = got["pid"]
    print(f"stopping pid={pid} …")
    try:
        os.kill(pid, signal.SIGTERM)
    except OSError as e:
        print(f"kill failed: {e}", file=sys.stderr)
        return 1
    for _ in range(50):
        time.sleep(0.1)
        if not pid_alive(pid):
            break
    else:
        try:
            os.kill(pid, signal.SIGKILL)
        except OSError:
            pass
    time.sleep(0.2)
    reg = REGISTRY / f"{pid}.json"
    if reg.exists():
        try:
            d = json.loads(reg.read_text())
            if d.get("name") == NAME:
                reg.unlink(missing_ok=True)
                sock = d.get("messagingSocketPath")
                if sock:
                    Path(sock).unlink(missing_ok=True)
        except Exception:
            pass
    if PIDFILE.exists():
        try:
            if PIDFILE.read_text().strip() == str(pid):
                PIDFILE.unlink(missing_ok=True)
        except Exception:
            pass
    print("stopped")
    return 0


def cmd_inbox(args: argparse.Namespace) -> int:
    ensure_dirs()
    if not INBOX.exists():
        print("(inbox empty)")
        return 0
    lines = INBOX.read_text().splitlines()
    n = max(1, args.n)
    for line in lines[-n:]:
        try:
            rec = json.loads(line)
        except json.JSONDecodeError:
            print(line)
            continue
        mode = rec.get("from_mode") or rec.get("direction") or "send"
        who = rec.get("from_name") or rec.get("from") or "?"
        body = (rec.get("body") or "").replace("\n", "\\n")
        if len(body) > 200:
            body = body[:200] + "…"
        print(
            f"{rec.get('ts')}  id={rec.get('msg_id')}  mode={mode}  from={who}\n"
            f"  {body}"
        )
    return 0


def cmd_pending(_: argparse.Namespace) -> int:
    ensure_dirs()
    files = sorted(PENDING_DIR.glob("*.json"))
    if not files:
        print("(no pending asks)")
        return 0
    for f in files:
        try:
            rec = json.loads(f.read_text())
        except Exception:
            print(f"{f.name}: (unreadable)")
            continue
        body = (rec.get("body") or "").replace("\n", "\\n")
        if len(body) > 120:
            body = body[:120] + "…"
        print(
            f"id={rec.get('msg_id')}  from={rec.get('from_name') or rec.get('from')}  "
            f"at={rec.get('received_at')}\n  {body}"
        )
    return 0


def cmd_reply(args: argparse.Namespace) -> int:
    ensure_dirs()
    msg_id = args.msg_id
    text = " ".join(args.text)
    if not text:
        print("reply text required", file=sys.stderr)
        return 2
    path = PENDING_DIR / f"{msg_id}.json"
    if not path.exists():
        print(f"no pending ask with id {msg_id}", file=sys.stderr)
        return 1
    try:
        rec = json.loads(path.read_text())
    except Exception as e:
        print(f"bad pending file: {e}", file=sys.stderr)
        return 1
    from_sock = rec.get("from_sock") or ""
    if not from_sock:
        from_addr = rec.get("from") or ""
        if from_addr.startswith("uds:"):
            from_sock = from_addr[4:]
    if not from_sock:
        print("pending record has no from socket", file=sys.stderr)
        return 1

    got = find_running()
    own_from = f"uds:{got['sock']}" if got else f"uds:unknown"
    hops = rec.get("hops") or 1
    content = build_envelope(
        text,
        from_addr=own_from,
        from_name=NAME,
        from_mode=REPLY_MODE,
        hops=hops,
    )
    frame = build_user_frame(content, from_addr=own_from)
    try:
        send_frame(from_sock, frame)
    except OSError as e:
        print(f"failed to send reply to {from_sock}: {e}", file=sys.stderr)
        return 1

    path.unlink(missing_ok=True)
    remaining = list(PENDING_DIR.glob("*.json"))
    if got and got.get("pid"):
        reg = REGISTRY / f"{got['pid']}.json"
        if reg.exists():
            try:
                d = json.loads(reg.read_text())
                d["status"] = "thinking" if remaining else "idle"
                write_json(reg, d)
            except Exception:
                pass

    now = datetime.now(timezone.utc).astimezone().isoformat(timespec="seconds")
    with INBOX.open("a") as f:
        f.write(
            json.dumps(
                {
                    "ts": now,
                    "msg_id": frame["msg_id"],
                    "direction": "outbound_reply",
                    "in_reply_to": msg_id,
                    "to": f"uds:{from_sock}",
                    "body": text,
                }
            )
            + "\n"
        )
    print(f"replied {frame['msg_id']} -> {from_sock} (cleared pending {msg_id})")
    return 0


def main() -> int:
    ap = argparse.ArgumentParser(
        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter
    )
    sub = ap.add_subparsers(dest="cmd", required=True)

    p = sub.add_parser("start", help="Bind sock + register; serve forever")
    p.add_argument(
        "--background",
        "-b",
        action="store_true",
        help="Detach (nohup-style) and write pidfile",
    )
    p.set_defaults(func=cmd_start)

    p = sub.add_parser("status", help="Show registered/live state")
    p.set_defaults(func=cmd_status)

    p = sub.add_parser("stop", help="Stop background/running instance")
    p.set_defaults(func=cmd_stop)

    p = sub.add_parser("inbox", help="Show recent inbound messages")
    p.add_argument("-n", type=int, default=20, help="Lines to show (default 20)")
    p.set_defaults(func=cmd_inbox)

    p = sub.add_parser("pending", help="List unanswered asks")
    p.set_defaults(func=cmd_pending)

    p = sub.add_parser("reply", help="Reply to a pending ask")
    p.add_argument("msg_id")
    p.add_argument("text", nargs="+")
    p.set_defaults(func=cmd_reply)

    args = ap.parse_args()
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())
