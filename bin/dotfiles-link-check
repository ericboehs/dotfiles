#!/usr/bin/env bash

# Audit every path bootstrap manages as a symlink into this repo.
#
# Writing *over* a managed link instead of through it -- the classic being
# `jq ... > tmp && mv tmp ~/.pi/agent/settings.json` -- leaves a real file that
# reads correctly and works, so nothing looks wrong. The next bootstrap renames
# it to .bak and restores the link, and every edit made in between is gone. The
# gap between mistake and symptom is the whole problem; this closes it.
#
# Usage: dotfiles-link-check [PATH_PREFIX ...]
# With no arguments, checks everything. A prefix limits the audit (~/.pi).
#
# The reverse drift is checked too: config tracked here that no [dotfiles]
# entry links, which works on the machine where it was set up by hand and is
# simply absent on the next one. .dotfiles-unmanaged lists what is unlinked on
# purpose.

set -euo pipefail

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  cat <<'EOF'
Usage: dotfiles-link-check [PATH_PREFIX ...]

Check that every path bootstrap manages is still the symlink it made, and that
it still points where it should. Reports three failures:

  - a regular file where a link belongs (the next bootstrap renames it .bak,
    and any edit written through it goes too)
  - a link to another host's file, e.g. settings.<host>.json after a rename
  - a dangling link

A path prefix limits the audit to part of the tree: dotfiles-link-check ~/.pi

An unscoped run also reports the reverse: files tracked in this repo that no
[dotfiles] entry links, so they never reach a fresh machine. Paths that are
unlinked on purpose are listed in .dotfiles-unmanaged.
EOF
  exit 0
fi

root="${PI_DOTFILES_ROOT:-$(cd -P "$(dirname "$0")" && pwd)}"
root="${root%/bin}"
manifest="$root/mise.toml"
unmanaged="$root/.dotfiles-unmanaged"

work="$(mktemp -d -t dotfiles-link-check.XXXXXX)"
trap 'rm -rf "$work"' EXIT

# Patterns for paths that are tracked but deliberately unlinked, stripped of
# the comments that say why.
patterns="$work/unmanaged"
# The list of what is unlinked on purpose is itself unlinked on purpose.
printf '%s\n' "${unmanaged##*/}" > "$patterns"
if [[ -f "$unmanaged" ]]; then
  sed -e 's/[[:space:]]*$//' -e '/^#/d' -e '/^$/d' "$unmanaged" >> "$patterns"
fi

if [[ ! -f "$manifest" ]]; then
  echo "dotfiles-link-check: no mise.toml under $root" >&2
  exit 1
fi

# Which host's per-host files this machine wants, resolved exactly as
# bootstrap:pi resolves it.
resolve_host() {
  local host="${PI_SETTINGS_HOST:-}"
  if [[ -z "$host" && -f "$root/.pi-agent/host" ]]; then
    host="$(tr -d '[:space:]' < "$root/.pi-agent/host")"
  fi
  [[ -n "$host" ]] || host="$(hostname -s | tr '[:upper:]' '[:lower:]')"
  printf '%s' "$host"
}

# Every managed link as "target<TAB>source". A source of "-" means this repo
# cannot know it -- the assistant profile's persona files and the VA context
# file live in private repos -- which still leaves "is it a link at all", the
# part that catches an overwrite.
managed_links() {
  local target source mode entry host

  # The [dotfiles] table is the bulk of it, and reading the table rather than
  # restating it means a link added there is audited without touching this
  # script. Two forms: a plain "target = source" string, and an inline table
  # with mode = "symlink-each", where the directory is real and its contents
  # are the links.
  while IFS=$'\t' read -r target source mode; do
    target="$HOME/${target#\~/}"
    if [[ "$mode" == "symlink-each" ]]; then
      [[ -d "$root/$source" ]] || continue
      for entry in "$root/$source"/*; do
        [[ -e "$entry" ]] || continue
        printf '%s\t%s\n' "$target/${entry##*/}" "$entry"
      done
    else
      printf '%s\t%s\n' "$target" "$root/$source"
    fi
  done < <(sed -n '/^\[dotfiles\]/,/^\[[a-z]/p' "$manifest" |
    sed -nE 's/^"([^"]+)"[[:space:]]*=[[:space:]]*\{[^}]*source[[:space:]]*=[[:space:]]*"([^"]+)"[^}]*mode[[:space:]]*=[[:space:]]*"([^"]+)".*/\1\t\2\t\3/p;
             s/^"([^"]+)"[[:space:]]*=[[:space:]]*"([^"]+)".*/\1\t\2\t/p')

  # bootstrap:pi makes the per-host links itself, so they are not in the table.
  host="$(resolve_host)"
  printf '%s\t%s\n' "$HOME/.pi/agent/settings.json" "$root/.pi-agent/settings.$host.json"
  # A host with no models.<host>.json keeps a real models.json of its own.
  [[ -f "$root/.pi-agent/models.$host.json" ]] &&
    printf '%s\t%s\n' "$HOME/.pi/agent/models.json" "$root/.pi-agent/models.$host.json"

  # bootstrap:pi-assistant, when that profile exists: shared resources point at
  # the coding profile, the persona files at a private source.
  if [[ -d "$HOME/.pi/assistant" ]]; then
    for entry in auth.json models.json keybindings.json npm git bin; do
      printf '%s\t%s\n' "$HOME/.pi/assistant/$entry" "$HOME/.pi/agent/$entry"
    done
    printf '%s\t%s\n' "$HOME/.pi/assistant/extensions" "$root/.pi-agent/extensions"
    for entry in settings.json AGENTS.md approval-guardian.json prompts; do
      printf '%s\t%s\n' "$HOME/.pi/assistant/$entry" "-"
    done
  fi

  # bootstrap:va-context, on a host that has the work tree.
  [[ -d "$HOME/Code/va.ghe.com" ]] &&
    printf '%s\t%s\n' "$HOME/Code/va.ghe.com/AGENTS.md" "-"

  return 0
}

in_scope() {
  local target="$1" prefix
  [[ "$#" -eq 1 ]] && return 0
  shift
  for prefix in "$@"; do
    prefix="${prefix/#\~\//$HOME/}"
    [[ "$target" == "$prefix"* ]] && return 0
  done
  return 1
}

status=0
checked=0

while IFS=$'\t' read -r target source; do
  [[ -n "$target" ]] || continue
  in_scope "$target" "$@" || continue
  # Absent is fine: bootstrap has not run on this host, or does not want it
  # here. Only a path that exists can be the wrong kind of thing.
  [[ -e "$target" || -L "$target" ]] || continue
  checked=$((checked + 1))

  want="$source"
  [[ "$want" == "-" ]] && want="a link bootstrap manages"

  if [[ ! -L "$target" ]]; then
    echo "dotfiles-link-check: $target is a regular file where $want belongs — the next bootstrap renames it to ${target##*/}.bak, and every edit made through it goes with it" >&2
    status=1
  elif [[ ! -e "$target" ]]; then
    echo "dotfiles-link-check: $target is a dangling link to $(readlink "$target")" >&2
    status=1
  elif [[ "$source" != "-" && ! "$target" -ef "$source" ]]; then
    echo "dotfiles-link-check: $target points at $(readlink "$target"), not $source — editing the tracked file is not editing what is in use" >&2
    status=1
  fi
done < <(managed_links)

if [[ "$status" -eq 0 ]]; then
  echo "dotfiles-link-check: $checked managed path(s) intact"
fi

# The reverse question: not "is this link still a link" but "does this tracked
# file reach any machine at all". A config set up by hand years ago works here
# and is missing on the next machine, and nothing about the working machine
# says so. Only for an unscoped run: a prefix scopes $HOME paths, and these are
# repo paths.
if [[ "$#" -eq 0 ]] && command -v git >/dev/null 2>&1 && [[ -d "$root/.git" ]]; then
  tracked="$work/tracked"
  covered="$work/covered"
  found="$work/found"
  orphans="$work/orphans"
  git -C "$root" ls-files | sort > "$tracked"
  managed_links | cut -f2 | sed -n "s|^$root/||p" | sort -u > "$covered"

  : > "$found"
  while IFS= read -r file; do
    skip=""
    while IFS= read -r pattern; do
      # shellcheck disable=SC2053  # the pattern is meant to glob
      [[ "$file" == $pattern ]] && { skip=1; break; }
    done < "$patterns"
    [[ -n "$skip" ]] && continue
    while IFS= read -r source; do
      [[ "$file" == "$source" || "$file" == "$source"/* ]] && { skip=1; break; }
    done < "$covered"
    [[ -n "$skip" ]] || printf '%s\n' "$file" >> "$found"
  done < "$tracked"
  mv "$found" "$orphans"

  # Report the directory rather than its dozen files, but only when the whole
  # directory is unlinked -- a covered sibling means the file is the anomaly.
  groups="$work/groups"
  : > "$groups"
  # shellcheck disable=SC2094  # $orphans is complete before this loop reads it
  while IFS= read -r file; do
    group="$file"
    case "$file" in
      */*/*)
        prefix="${file%%/*}/$(printf '%s' "${file#*/}" | cut -d/ -f1)"
        if [[ "$(grep -c "^$prefix/" "$tracked")" == "$(grep -c "^$prefix/" "$orphans")" ]]; then
          group="$prefix"
        fi
        ;;
    esac
    printf '%s\n' "$group" >> "$groups"
  done < "$orphans"

  while IFS= read -r group; do
    [[ -n "$group" ]] || continue
    echo "dotfiles-link-check: $group is tracked but no [dotfiles] entry links it — it reaches no machine but this one, where it was set up by hand" >&2
    status=1
  done < <(sort -u "$groups")
fi

exit "$status"
