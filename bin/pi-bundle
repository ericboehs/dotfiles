#!/usr/bin/env bash

# Bundle the installed pi into a single file and point the `pi` bin at it.
# Usage: pi-bundle [-h|--help] [--status|--off]
#
# pi ships its Node build as ~200 ES modules, and 177 of them load before the
# first frame. Collapsing them into one file takes ~115ms off every launch.
#
# Two patches are needed, and they only pay off together:
#
#   1. The extension loader derives its jiti aliases from its own module path
#      (`import.meta.url` then `../..`), which moves when everything collapses
#      into one file.
#   2. It only uses the in-memory `virtualModules` path when it believes it is
#      a compiled or explicitly bundled binary. Without that, the first extension that imports
#      @earendil-works/pi-coding-agent resolves to dist/index.js on disk and
#      jiti loads pi's entire module graph a second time — which makes the
#      bundle *slower* than the stock build. Measured at +313ms on one
#      extension, so bundling without this reads as a regression.
#
# The entrypoint is dist/bun/cli.js, not dist/cli.js. pi deliberately hides its
# OAuth flows and the bedrock provider from bundlers behind variable import
# specifiers, and dist/bun/cli.js is the entry that statically registers them
# again for its own Bun binary. Bundling dist/cli.js instead produces a pi that
# starts fine and then fails every OAuth provider at runtime with
# "Cannot find module .../dist/openai-codex.js".
#
# Nothing in the install is modified. The bundle is built from a patched copy
# and dropped next to dist/cli.js, and the `pi` bin points at bin/pi-launch,
# which falls back to dist/cli.js whenever the bundle is missing or older than
# the package. A pi upgrade therefore degrades to stock speed, never breakage;
# re-run this afterwards (mise task bootstrap:pi does).
#
# Where the bin is a generated shim script rather than a symlink (mise's npm
# backend), the shim's own entrypoint selection is rewritten instead, with the
# stock copy kept alongside as pi.pre-bundle.

set -euo pipefail

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  echo "Usage: $(basename "$0") [--status|--off]"
  echo ""
  echo "Bundle the installed pi into dist/bundle.mjs and point the pi bin at"
  echo "bin/pi-launch, which prefers the bundle and falls back to dist/cli.js."
  echo ""
  echo "  --status   show what the pi bin currently points at"
  echo "  --off      restore the stock entrypoint and delete the bundle"
  echo ""
  echo "PI_BIN=<path>          locate the install through a pi that is not on PATH"
  echo "PI_BUNDLE_NO_LINK=1    build the bundle without repointing the bin"
  echo "PI_BUNDLE_NO_BEDROCK=1 leave the AWS SDK out (~30ms faster, breaks bedrock)"
  echo "PI_NO_BUNDLE=1         skip the bundle for one launch"
  echo "PI_NO_COMPILE_CACHE=1  skip bin/pi-launch's V8 compile cache for one launch"
  exit 0
fi

RED=$'\033[0;31m'; GREEN=$'\033[0;32m'; YELLOW=$'\033[1;33m'; NC=$'\033[0m'
die() { echo "${RED}❌ $*${NC}" >&2; exit 1; }

# bin/ is symlinked to ~/bin, so resolve the real script location.
target="${BASH_SOURCE[0]}"
while [ -L "$target" ]; do
  link="$(readlink "$target")"
  case "$link" in
    /*) target="$link" ;;
    *) target="$(dirname "$target")/$link" ;;
  esac
done
LAUNCHER="$(cd "$(dirname "$target")" && pwd)/pi-launch"
[ -x "$LAUNCHER" ] || die "bin/pi-launch is missing or not executable"

command -v node >/dev/null || die "node is not on PATH"

# Locate the install through the pi bin rather than the node prefix: mise's npm
# backend puts pi in a plain node_modules/.bin, nowhere near bin/node. Both
# layouts are relative to the directory holding the bin, which stays true after
# this script repoints that bin at pi-launch. PI_BIN overrides for a pi that is
# not on PATH (a remote box driven over ssh, say).
PI_BIN="${PI_BIN:-$(command -v pi || true)}"
[ -n "$PI_BIN" ] || die "pi is not on PATH (set PI_BIN to its path)"
BIN_DIR="$(cd "$(dirname "$PI_BIN")" && pwd)"
PKG=""
for rel in ../lib/node_modules/@earendil-works/pi-coding-agent ../@earendil-works/pi-coding-agent; do
  # -P: mise's npm backend symlinks the package into a pnpm-style store and
  # keeps the dependencies there, so only the physical path resolves them.
  if [ -d "$BIN_DIR/$rel" ]; then PKG="$(cd "$BIN_DIR/$rel" && pwd -P)"; break; fi
done
[ -n "$PKG" ] || die "no pi install found next to $BIN_DIR"
VERSION="$(node -p "require('$PKG/package.json').version")"
BUNDLE="$PKG/dist/bundle.mjs"
PI_BIN_LINK="$BIN_DIR/pi"
SHIM_BACKUP="$PI_BIN_LINK.pre-bundle"
# Kept in step with bin/pi-launch, which points node at it on every launch.
COMPILE_CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/pi/v8"

# mise's npm backend writes a generated shim script at the bin path instead of
# a symlink, so there is nothing to repoint. Rewrite the shim's own entrypoint
# selection instead, keeping the stock file as the fallback.
is_shim() { [ -f "$PI_BIN_LINK" ] && [ ! -L "$PI_BIN_LINK" ] && grep -q 'dist/cli\.js' "$PI_BIN_LINK"; }

patch_shim() {
  [ -f "$SHIM_BACKUP" ] || cp -p "$PI_BIN_LINK" "$SHIM_BACKUP"
  node - "$SHIM_BACKUP" "$PI_BIN_LINK" <<'SHIM' || die "could not patch $PI_BIN_LINK (restore it from $SHIM_BACKUP)"
const fs = require("node:fs");
const [, , from, to] = process.argv;
const src = fs.readFileSync(from, "utf8");

// Every exec line points at the same "$basedir/<rel>/dist/cli.js".
const m = src.match(/exec (?:"\$basedir\/node"|node) "\$basedir\/(\S+)\/dist\/cli\.js"/);
if (!m) { console.error("no exec line naming dist/cli.js"); process.exit(1); }
const rel = m[1];

const guard = [
  "",
  "# pi-bundle: prefer the single-file bundle, but only while it is present and",
  "# no older than the package, so an upgrade degrades to stock speed.",
  `pi_entry="$basedir/${rel}/dist/bundle.mjs"`,
  `{ [ -z "$PI_NO_BUNDLE" ] && [ -f "$pi_entry" ] && [ ! "$basedir/${rel}/package.json" -nt "$pi_entry" ]; } \\`,
  `  || pi_entry="$basedir/${rel}/dist/cli.js"`,
  "",
].join("\n");

const anchor = 'basedir=$(dirname "$link")\n';
if (!src.includes(anchor)) { console.error("no basedir assignment to anchor on"); process.exit(1); }

const out = src
  .split(`"$basedir/${rel}/dist/cli.js"`).join('"$pi_entry"')
  .replace(anchor, anchor + guard);
fs.writeFileSync(to, out);
fs.chmodSync(to, 0o755);
SHIM
}

if [[ "${1:-}" == "--status" ]]; then
  echo "pi        $VERSION ($PKG)"
  if [ -L "$PI_BIN_LINK" ]; then
    echo "bin       $PI_BIN_LINK -> $(readlink "$PI_BIN_LINK")"
  elif [ -f "$SHIM_BACKUP" ]; then
    echo "bin       $PI_BIN_LINK (shim, patched; stock copy at $(basename "$SHIM_BACKUP"))"
  else
    echo "bin       $PI_BIN_LINK (shim, unpatched)"
  fi
  if [ -f "$BUNDLE" ]; then
    stale=""
    [ "$PKG/package.json" -nt "$BUNDLE" ] && stale=" ${YELLOW}(stale: older than the package)${NC}"
    echo "bundle    $(du -h "$BUNDLE" | cut -f1) built $(date -r "$BUNDLE" "+%Y-%m-%d %H:%M")$stale"
  else
    echo "bundle    ${YELLOW}not built${NC}"
  fi
  if [ -d "$COMPILE_CACHE" ]; then
    echo "v8 cache  $(du -sh "$COMPILE_CACHE" | cut -f1) at $COMPILE_CACHE"
  else
    echo "v8 cache  ${YELLOW}empty${NC} (populates on the next launch)"
  fi
  exit 0
fi

if [[ "${1:-}" == "--off" ]]; then
  [ -L "$PI_BIN_LINK" ] && ln -sfn "$PKG/dist/cli.js" "$PI_BIN_LINK"
  [ -f "$SHIM_BACKUP" ] && mv -f "$SHIM_BACKUP" "$PI_BIN_LINK"
  rm -f "$BUNDLE"
  # The bin no longer goes through pi-launch, so nothing would ever read these.
  rm -rf "$COMPILE_CACHE"
  echo "${GREEN}✅ restored the stock entrypoint${NC}"
  exit 0
fi

[[ -z "${1:-}" ]] || die "unknown argument: $1"

# Patch a copy, never the install. The copy goes next to the package rather
# than in /tmp so that bare imports resolve exactly as they do for the real
# thing: npm nests dependencies under the package, mise's npm backend hoists
# them into a store directory one level up, and only a sibling sees both.
STAGE="$(dirname "$PKG")/.pi-bundle-stage.$$"
mkdir -p "$STAGE" 2>/dev/null || STAGE="$(mktemp -d)"
trap 'rm -rf "$STAGE"' EXIT
cp -R "$PKG/dist" "$STAGE/dist"
[ -d "$PKG/node_modules" ] && ln -s "$PKG/node_modules" "$STAGE/node_modules"
ln -s "$PKG/package.json" "$STAGE/package.json"

node - "$STAGE/dist/core/extensions/loader.js" <<'PATCH' || die "loader.js does not look the way this script expects — pi may have changed it"
const fs = require("node:fs");
const file = process.argv[2];
let src = fs.readFileSync(file, "utf8");

const dirnameFrom = "    const __dirname = path.dirname(fileURLToPath(import.meta.url));";
const dirnameTo =
  '    const __dirname = path.join(path.dirname(fileURLToPath(import.meta.url)), "core/extensions");';
if (!src.includes(dirnameFrom)) {
  console.error("pattern not found: " + JSON.stringify(dirnameFrom.trim().slice(0, 70)));
  process.exit(1);
}
src = src.split(dirnameFrom).join(dirnameTo);

// Take the virtualModules branch: extensions must get the copies of pi that
// are already in this bundle, not a second graph loaded off disk. Pi 0.84
// widened the condition for Node SEA and its own bundled-node build, so accept
// both layouts while still failing closed on an unfamiliar loader.
const virtualConditions = [
  "        ...(isBunBinary || isNodeSeaBinary || isBundledNode\n",
  "        ...(isBunBinary\n",
];
const virtualCondition = virtualConditions.find((candidate) => src.includes(candidate));
if (!virtualCondition) {
  console.error("virtualModules condition not found");
  process.exit(1);
}
src = src.split(virtualCondition).join("        ...(true\n");
fs.writeFileSync(file, src);
PATCH

TMP="$PKG/dist/.bundle.tmp.mjs"
rm -f "$TMP"
# dist/bun/cli.js registers the OAuth flows and the bedrock provider that pi
# hides from bundlers, then defers to ../cli.js. Older versions may not ship it.
ENTRY="$STAGE/dist/bun/cli.js"
[ -f "$ENTRY" ] || { ENTRY="$STAGE/dist/cli.js"; echo "${YELLOW}dist/bun/cli.js is missing — OAuth providers may not work${NC}"; }

# Registering bedrock drags the whole AWS SDK in and evaluates it on every
# launch: 32ms and 0.7MB (608ms -> 576ms to first frame here) for a provider
# most installs never authenticate. Opt-in rather than default, since silently
# disabling a provider is the bug this entrypoint exists to fix — and refuse to
# do it quietly to someone who actually has bedrock credentials.
if [ -n "${PI_BUNDLE_NO_BEDROCK:-}" ] && [ "$ENTRY" = "$STAGE/dist/bun/cli.js" ]; then
  auth_file="${PI_CODING_AGENT_DIR:-$HOME/.pi/agent}/auth.json"
  if [ -f "$auth_file" ] && grep -q '"bedrock"' "$auth_file"; then
    echo "${YELLOW}PI_BUNDLE_NO_BEDROCK is set but $auth_file has bedrock credentials — keeping bedrock${NC}" >&2
  else
  node - "$ENTRY" <<'BEDROCK' || die "could not remove the bedrock registration from dist/bun/cli.js"
const fs = require("node:fs");
const file = process.argv[2];
const src = fs.readFileSync(file, "utf8");
const line = 'await import("./register-bedrock.js");\n';
if (!src.includes(line)) { console.error("register-bedrock import not found"); process.exit(1); }
fs.writeFileSync(file, src.replace(line, ""));
BEDROCK
    no_bedrock=1
  fi
fi
if command -v bun >/dev/null; then
  # Whitespace and syntax only: mangling identifiers buys nothing measurable
  # and costs readable function names in pi's own stack traces.
  bun build "$ENTRY" --target=node --format=esm \
    --minify-whitespace --minify-syntax --external '*.node' --outfile "$TMP" >/dev/null
else
  echo "${YELLOW}bun not found — falling back to npx esbuild${NC}"
  npx --yes esbuild@0.25 "$ENTRY" --bundle --platform=node --format=esm \
    --target=node24 --external:*.node --log-level=error --outfile="$TMP" \
    --banner:js='import{createRequire as __pcr}from "node:module";import{fileURLToPath as __pfu}from "node:url";import{dirname as __pdn}from "node:path";const require=__pcr(import.meta.url);const __filename=__pfu(import.meta.url);const __dirname=__pdn(__filename);'
fi
[ -s "$TMP" ] || die "the bundler produced nothing"

# Smoke test before it becomes the entrypoint: --version proves the graph
# evaluates, `list` proves settings and the package manager still resolve, and
# `auth check` has to agree with the stock build for every OAuth provider —
# that last one is what catches a bundle whose provider imports went missing.
#
# These run against the real ~/.pi/agent on purpose. Pointing them at a scratch
# PI_CODING_AGENT_DIR would make both sides answer credentials_not_configured
# and the comparison would pass vacuously, which is exactly how the broken
# bundle survived a day. All three commands leave settings.json byte-identical
# (measured), but settings.json is a tracked symlink here, so verify that
# instead of trusting it.
SETTINGS="${PI_CODING_AGENT_DIR:-$HOME/.pi/agent}/settings.json"
settings_before=""
[ -f "$SETTINGS" ] && settings_before="$(cat "$SETTINGS")"

built="$(node "$TMP" --version 2>&1 | tail -1)"
[ "$built" = "$VERSION" ] || { rm -f "$TMP"; die "bundle reports version '$built', expected '$VERSION'"; }
node "$TMP" list >/dev/null 2>&1 || { rm -f "$TMP"; die "bundle failed to run 'pi list'"; }
for provider in openai-codex anthropic; do
  # An unconfigured provider exits non-zero; only the answers have to match.
  want="$(node "$PKG/dist/cli.js" auth check --provider "$provider" --no-refresh --json 2>&1 | tail -1 || true)"
  got="$(node "$TMP" auth check --provider "$provider" --no-refresh --json 2>&1 | tail -1 || true)"
  [ "$got" = "$want" ] || { rm -f "$TMP"; die "bundle disagrees with the stock build on $provider auth:"$'\n'"  stock:  $want"$'\n'"  bundle: $got"; }
done

if [ -n "$settings_before" ] && [ "$settings_before" != "$(cat "$SETTINGS")" ]; then
  printf '%s' "$settings_before" > "$SETTINGS"
  echo "${YELLOW}pi rewrote settings.json during the smoke tests — restored it${NC}" >&2
fi

mv -f "$TMP" "$BUNDLE"

# pi-ai loads bedrock through a variable specifier specifically so bundlers
# cannot follow it into the AWS SDK. At runtime that resolves against whoever
# imported it — here dist/bundle.mjs — so a bedrock request looks for
# dist/bedrock-converse-stream.js, which ships nowhere. Write a re-export shim
# at exactly that path pointing at the real module. Where the real module lives
# differs by install layout: npm hoists it under the package's own node_modules,
# while mise's npm plugin gives each dependency its own store slot beside ours,
# so check both rather than guess. pi-ai's exports map hides this path from
# require.resolve entirely, which is why this is filesystem work.
# Verified the other lazy APIs don't need this: they use static imports and
# get inlined like everything else.
# || true inside the substitution: under pipefail, head -1 closing the pipe
# SIGPIPEs find (exit 141) and set -e would abort the whole script silently —
# which is exactly what happened on the Linux box, mid-success.
shim_target="$( \
  (find -L "$PKG/node_modules" "$PKG/../../../.." \
    -maxdepth 7 -path "*@earendil-works/pi-ai/dist/api/bedrock-converse-stream.js" 2>/dev/null || true) | head -1)"
if [ -n "$shim_target" ]; then
  node - "$PKG" "${shim_target%/dist/*}" "$shim_target" >/dev/null <<'SHIM'
const fs = require("node:fs");
const path = require("node:path");
const [, , pkg, , target] = process.argv;
const rel = path.posix.relative(path.join(pkg, "dist"), target);
const body =
  "// Written by bin/pi-bundle: the bundled lazy loader resolves its variable\n" +
  "// import against dist/, not against @earendil-works/pi-ai/dist/api where the\n" +
  "// real module lives. Re-export it rather than copying it, so its relative and\n" +
  "// bare imports keep resolving from home.\n" +
  `export * from ${JSON.stringify(rel.startsWith(".") ? rel : `./${rel}`)};\n`;
fs.writeFileSync(path.join(pkg, "dist", "bedrock-converse-stream.js"), body);
SHIM
else
  echo "${YELLOW}could not locate pi-ai bedrock module; bedrock may fail through the bundle${NC}" >&2
fi
size="$(du -h "$BUNDLE" | cut -f1)"
# Every entry in there is keyed to the bundle that just got replaced. Node would
# miss on all of them and write new ones alongside, so the directory would grow
# by ~1.4MB per pi release and never shrink.
rm -rf "$COMPILE_CACHE"
note=""
[ -n "${no_bedrock:-}" ] && note=" ${YELLOW}without bedrock${NC}"
if [ -n "${PI_BUNDLE_NO_LINK:-}" ]; then
  echo "${GREEN}✅ bundled pi $VERSION${NC} ($size)$note — left $PI_BIN_LINK alone"
elif [ -L "$PI_BIN_LINK" ] || [ ! -e "$PI_BIN_LINK" ]; then
  ln -sfn "$LAUNCHER" "$PI_BIN_LINK"
  echo "${GREEN}✅ bundled pi $VERSION${NC} ($size)$note — $PI_BIN_LINK now goes through pi-launch"
elif is_shim; then
  patch_shim
  echo "${GREEN}✅ bundled pi $VERSION${NC} ($size)$note — patched the shim at $PI_BIN_LINK"
else
  echo "${GREEN}✅ bundled pi $VERSION${NC} ($size)"
  echo "${YELLOW}   $PI_BIN_LINK is neither a symlink nor a shim this script knows — left alone.${NC}"
  echo "${YELLOW}   Run pi as: node $BUNDLE${NC}"
fi
