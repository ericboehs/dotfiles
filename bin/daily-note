#!/bin/bash

# Required parameters:
# @raycast.schemaVersion 1
# @raycast.title Open Daily Note
# @raycast.mode silent

# Optional parameters:
# @raycast.icon 📓
# @raycast.packageName Wiki
# @raycast.description Open today's daily note in Typora, creating it if needed.

# Documentation:
# @raycast.author Eric Boehs
# @raycast.authorURL boehs.com

# Usage: daily-note [editor]
#   No argument: open in Typora (the Raycast default).
#   With an editor command (e.g. `daily-note nvim`), create the note if
#   needed then exec that editor — used by tmux's Ctrl-B W binding.

set -euo pipefail

EDITOR_CMD="${1:-}"

DAILY_DIR="$HOME/Documents/Wiki/daily"
TODAY=$(date +%Y-%m-%d)
NOTE="$DAILY_DIR/$TODAY.md"

if [ ! -f "$NOTE" ]; then
  mkdir -p "$DAILY_DIR"
  cat > "$NOTE" <<EOF
# $TODAY ($(date +%A))

> Week: [[$(date +%G-W%V)]].

## TODO

### Work

### Personal / Tinkering

### Solar Shop

### Personal / Farm

## Notes
EOF
fi

if [ -n "$EDITOR_CMD" ]; then
  exec "$EDITOR_CMD" "$NOTE"
fi

open -a Typora "$NOTE"
