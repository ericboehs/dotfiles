#!/usr/bin/env bash
# Install teams-capture as a launchd agent that records every Teams meeting.
#
# The script form runs under `swift`, which is awkward for TCC: Accessibility
# permission would have to be granted to the Swift compiler. So compile a real
# binary and grant permission to that.
#
# Not an .app bundle, tempting as the friendlier name in the Accessibility list
# is: TCC refuses an ad-hoc signed bundle ("failed to match existing code
# requirement"), because it wants an Apple-anchored requirement. Bare binaries
# are matched by path, which ad-hoc signing satisfies.

set -euo pipefail

bundle_id="com.ericboehs.teams-capture"
label="$bundle_id"
source_script="${BASH_SOURCE[0]%/*}/teams-capture"
binary="$HOME/.local/bin/teams-capture-daemon"
plist="$HOME/Library/LaunchAgents/$label.plist"
state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/teams-capture"
stamp="$state_dir/source.sha256"
log="$state_dir/launchd.log"
# macOS ties an Accessibility grant to the binary's code signature. Ad-hoc
# signing re-hashes on every build, so each rebuild drops the permission. Set
# TEAMS_CAPTURE_SIGN_ID to a Developer ID to keep it across rebuilds; without
# one, `reauthorize` below makes re-granting a two-step affair.
sign_id="${TEAMS_CAPTURE_SIGN_ID:--}"

settings_pane="x-apple.systempreferences:com.apple.preference.security?Privacy_Accessibility"

case "${1:-install}" in
  uninstall)
    launchctl bootout "gui/$UID/$label" 2>/dev/null || true
    rm -rf "$plist" "$binary" "$stamp"
    echo "removed $label"
    exit 0
    ;;
  reauthorize)
    launchctl bootout "gui/$UID/$label" 2>/dev/null || true
    open "$settings_pane"
    open -R "$binary"
    echo "remove any existing teams-capture-daemon row, drag the revealed"
    echo "binary in, then:"
    echo "  launchctl bootstrap gui/$UID $plist"
    exit 0
    ;;
  install) ;;
  *)
    echo "usage: ${0##*/} [install|reauthorize|uninstall]" >&2
    exit 1
    ;;
esac

mkdir -p "${binary%/*}" "$state_dir"
rm -rf "$HOME/Applications/TeamsCapture.app" # from an earlier, rejected approach

# Only rebuild when the source changed: every rebuild costs the Accessibility
# grant unless a stable signing identity is in play.
source_hash=$(shasum -a 256 "$source_script" | cut -d' ' -f1)
rebuilt=false
if [[ ! -x $binary || ! -f $stamp || $(cat "$stamp") != "$source_hash" ]]; then
  echo "building $binary"
  build_dir=$(mktemp -d)
  trap 'rm -rf "$build_dir"' EXIT
  cp "$source_script" "$build_dir/teams-capture.swift"
  swiftc -O -o "$binary" "$build_dir/teams-capture.swift"
  # No --identifier: giving a bare binary a bundle-style id makes TCC try to
  # resolve it as an app, fail to find one, and reject the grant.
  codesign --force --sign "$sign_id" "$binary"
  echo "$source_hash" > "$stamp"
  rebuilt=true
else
  echo "$binary is current, skipping build"
fi

cat > "$plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>$label</string>
  <key>ProgramArguments</key>
  <array>
    <string>$binary</string>
    <string>--auto-captions</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>$HOME</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>60</integer>
  <!-- Not Background/LowPriorityIO: throttling starves the Accessibility
       round-trips until they time out, which looks like the meeting ended. -->
  <key>ProcessType</key>
  <string>Interactive</string>
  <key>StandardOutPath</key>
  <string>$log</string>
  <key>StandardErrorPath</key>
  <string>$log</string>
</dict>
</plist>
PLIST

launchctl bootout "gui/$UID/$label" 2>/dev/null || true
launchctl bootstrap "gui/$UID" "$plist"

cat <<INFO

installed $label
  binary:      $binary
  plist:       $plist
  log:         $log
  transcripts: ${XDG_DATA_HOME:-$HOME/.local/share}/teams-capture

  tail -f $log
INFO

if [[ $rebuilt == true && $sign_id == "-" ]]; then
  cat <<INFO

Ad-hoc signed, so macOS sees a new binary and drops any previous grant:
  ${BASH_SOURCE[0]} reauthorize
INFO
fi
